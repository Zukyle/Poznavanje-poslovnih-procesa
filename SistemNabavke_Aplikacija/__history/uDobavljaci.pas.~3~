unit uDobavljaci;

interface

uses
  Winapi.Windows,
  Winapi.Messages,
  System.SysUtils,
  System.Variants,
  System.Classes,

  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.StdCtrls,
  Vcl.ExtCtrls,
  Vcl.Grids,
  Vcl.DBGrids,
  Vcl.Buttons,
  Vcl.CheckLst,

  Data.DB,

  FireDAC.Stan.Intf,
  FireDAC.Stan.Option,
  FireDAC.Stan.Param,
  FireDAC.Stan.Error,
  FireDAC.DatS,
  FireDAC.Phys.Intf,
  FireDAC.DApt.Intf,
  FireDAC.Stan.Async,
  FireDAC.DApt,
  FireDAC.Comp.DataSet,
  FireDAC.Comp.Client;

type
  TfraDobavljaci = class(TFrame)

    pnlHeader: TPanel;
    lblNaslov: TLabel;
    lblOpis: TLabel;

    pnlTabela: TPanel;
    lblListaNaslov: TLabel;
    dbgDobavljaci: TDBGrid;

    pnlDetalji: TPanel;
    lblDetaljiNaslov: TLabel;

    lblNazivNaslov: TLabel;
    edtNaziv: TEdit;

    lblEmailNaslov: TLabel;
    edtEmail: TEdit;

    lblTelefonNaslov: TLabel;
    edtTelefon: TEdit;

    lblAdresaNaslov: TLabel;
    edtAdresa: TEdit;

    Panel1: TPanel;
    Panel3: TPanel;

    btnNovi: TButton;
    btnObrisi: TButton;
    btnSacuvaj: TButton;
    btnOtkazi: TButton;

    lblMaterijaliNaslov: TLabel;
    CheckListBox1: TCheckListBox;

  private

    FQryDobavljaci: TFDQuery;
    FDsDobavljaci: TDataSource;

    FIzabraniDobavljacID: Integer;
    FNoviDobavljac: Boolean;

    procedure UcitajDobavljace;
    procedure PodesiKolone;

    procedure PrikaziIzabranogDobavljaca;
    procedure OcistiPolja;

    // ========================================================
    // NOVO - MATERIJALI DOBAVLJAČA
    // ========================================================

    procedure UcitajMaterijale;

    procedure OcistiIzborMaterijala;

    procedure UcitajMaterijaleDobavljaca(
      ADobavljacID: Integer
    );

    procedure SacuvajMaterijaleDobavljaca(
      ADobavljacID: Integer
    );

    procedure qryDobavljaciAfterScroll(
      DataSet: TDataSet
    );

    procedure btnNoviClick(Sender: TObject);
    procedure btnSacuvajClick(Sender: TObject);
    procedure btnOtkaziClick(Sender: TObject);
    procedure btnObrisiClick(Sender: TObject);

    function PodaciValidni: Boolean;

    function DobavljacSeKoristi(
      ADobavljacID: Integer
    ): Boolean;

  public

    constructor Create(
      AOwner: TComponent
    ); override;

    procedure Osvezi;

  end;

implementation

uses
  uLogin;

{$R *.dfm}


// ============================================================
// KREIRANJE FRAME-A
// ============================================================

constructor TfraDobavljaci.Create(
  AOwner: TComponent
);
begin
  inherited Create(AOwner);


  // ==========================================================
  // QUERY
  // ==========================================================

  FQryDobavljaci :=
    TFDQuery.Create(Self);

  FQryDobavljaci.Connection :=
    frmLogin.FDConnection1;


  // ==========================================================
  // DATASOURCE
  // ==========================================================

  FDsDobavljaci :=
    TDataSource.Create(Self);

  FDsDobavljaci.DataSet :=
    FQryDobavljaci;


  // ==========================================================
  // DBGRID
  // ==========================================================

  dbgDobavljaci.DataSource :=
    FDsDobavljaci;

  dbgDobavljaci.ReadOnly :=
    True;

  dbgDobavljaci.Options :=
    dbgDobavljaci.Options + [dgRowSelect];


  // ==========================================================
  // QUERY DOGAĐAJ
  // ==========================================================

  FQryDobavljaci.AfterScroll :=
    qryDobavljaciAfterScroll;


  // ==========================================================
  // DUGMAD
  // ==========================================================

  btnNovi.OnClick :=
    btnNoviClick;

  btnSacuvaj.OnClick :=
    btnSacuvajClick;

  btnOtkazi.OnClick :=
    btnOtkaziClick;

  btnObrisi.OnClick :=
    btnObrisiClick;


  // ==========================================================
  // POČETNO STANJE
  // ==========================================================

  FIzabraniDobavljacID := 0;
  FNoviDobavljac := False;

  Osvezi;
end;


// ============================================================
// OSVEŽAVANJE
// ============================================================

procedure TfraDobavljaci.Osvezi;
begin

  // NOVO
  UcitajMaterijale;

  UcitajDobavljace;

end;


// ============================================================
// UČITAVANJE SVIH MATERIJALA
// ============================================================

procedure TfraDobavljaci.UcitajMaterijale;
var
  Q: TFDQuery;
begin

  CheckListBox1.Items.Clear;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT ' +
      'id, ' +
      'CAST(name AS VARCHAR(150)) AS naziv ' +

      'FROM materials ' +

      'ORDER BY name ASC';


    try

      Q.Open;


      while not Q.Eof do
      begin

        // Naziv materijala prikazujemo korisniku,
        // a njegov ID čuvamo u Objects.
        CheckListBox1.Items.AddObject(

          Q.FieldByName(
            'naziv'
          ).AsString,

          TObject(
            NativeInt(
              Q.FieldByName(
                'id'
              ).AsInteger
            )
          )

        );


        Q.Next;

      end;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom učitavanja materijala:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// ČIŠĆENJE IZBORA MATERIJALA
// ============================================================

procedure TfraDobavljaci.OcistiIzborMaterijala;
var
  I: Integer;
begin

  for I := 0 to CheckListBox1.Items.Count - 1 do
  begin

    CheckListBox1.Checked[I] :=
      False;

  end;

end;


// ============================================================
// UČITAVANJE MATERIJALA IZABRANOG DOBAVLJAČA
// ============================================================

procedure TfraDobavljaci.UcitajMaterijaleDobavljaca(
  ADobavljacID: Integer
);
var
  Q: TFDQuery;

  I: Integer;
  MaterialID: Integer;
begin

  // Prvo skidamo sve čekirane stavke
  OcistiIzborMaterijala;


  if ADobavljacID = 0 then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT material_id ' +

      'FROM supplier_materials ' +

      'WHERE supplier_id = :supplier_id';


    Q.ParamByName(
      'supplier_id'
    ).AsInteger :=
      ADobavljacID;


    Q.Open;


    // ========================================================
    // ZA SVAKU VEZU IZ BAZE TRAŽIMO MATERIJAL U CHECKLISTBOX-U
    // ========================================================

    while not Q.Eof do
    begin

      MaterialID :=
        Q.FieldByName(
          'material_id'
        ).AsInteger;


      for I := 0 to CheckListBox1.Items.Count - 1 do
      begin

        if Integer(
          NativeInt(
            CheckListBox1.Items.Objects[I]
          )
        ) = MaterialID then
        begin

          CheckListBox1.Checked[I] :=
            True;

          Break;

        end;

      end;


      Q.Next;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// ČUVANJE MATERIJALA DOBAVLJAČA
// ============================================================

procedure TfraDobavljaci.SacuvajMaterijaleDobavljaca(
  ADobavljacID: Integer
);
var
  Q: TFDQuery;

  I: Integer;
  MaterialID: Integer;
begin

  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    // ========================================================
    // PRVO BRIŠEMO STARE VEZE
    // ========================================================

    Q.SQL.Text :=

      'DELETE FROM supplier_materials ' +

      'WHERE supplier_id = :supplier_id';


    Q.ParamByName(
      'supplier_id'
    ).AsInteger :=
      ADobavljacID;


    Q.ExecSQL;


    // ========================================================
    // ONDA DODAJEMO TRENUTNO ČEKIRANE MATERIJALE
    // ========================================================

    for I := 0 to CheckListBox1.Items.Count - 1 do
    begin

      if CheckListBox1.Checked[I] then
      begin

        MaterialID :=
          Integer(
            NativeInt(
              CheckListBox1.Items.Objects[I]
            )
          );


        Q.Close;

        Q.SQL.Text :=

          'INSERT INTO supplier_materials ' +
          '(supplier_id, material_id) ' +

          'VALUES ' +
          '(:supplier_id, :material_id)';


        Q.ParamByName(
          'supplier_id'
        ).AsInteger :=
          ADobavljacID;


        Q.ParamByName(
          'material_id'
        ).AsInteger :=
          MaterialID;


        Q.ExecSQL;

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// UČITAVANJE DOBAVLJAČA
// ============================================================

procedure TfraDobavljaci.UcitajDobavljace;
begin

  FQryDobavljaci.Close;


  FQryDobavljaci.SQL.Text :=

    'SELECT ' +

    'id, ' +

    'CAST(name AS VARCHAR(150)) AS naziv, ' +

    'CAST(COALESCE(email, '''') ' +
    'AS VARCHAR(150)) AS email, ' +

    'CAST(COALESCE(phone, '''') ' +
    'AS VARCHAR(100)) AS telefon, ' +

    'CAST(COALESCE(address, '''') ' +
    'AS VARCHAR(250)) AS adresa ' +

    'FROM suppliers ' +

    'ORDER BY name ASC';


  try

    FQryDobavljaci.Open;

    PodesiKolone;


    if not FQryDobavljaci.IsEmpty then
    begin

      FQryDobavljaci.First;

      PrikaziIzabranogDobavljaca;

    end

    else
    begin

      OcistiPolja;

      btnObrisi.Enabled :=
        False;

    end;


  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja dobavljača:' +
        sLineBreak +
        E.Message
      );

      OcistiPolja;

    end;

  end;

end;


// ============================================================
// KOLONE
// ============================================================

procedure TfraDobavljaci.PodesiKolone;
begin

  dbgDobavljaci.Columns.Clear;


  with dbgDobavljaci.Columns.Add do
  begin

    FieldName := 'id';
    Title.Caption := 'ID';
    Width := 50;

  end;


  with dbgDobavljaci.Columns.Add do
  begin

    FieldName := 'naziv';
    Title.Caption := 'Naziv';
    Width := 170;

  end;


  with dbgDobavljaci.Columns.Add do
  begin

    FieldName := 'telefon';
    Title.Caption := 'Telefon';
    Width := 120;

  end;


  with dbgDobavljaci.Columns.Add do
  begin

    FieldName := 'email';
    Title.Caption := 'Email';
    Width := 180;

  end;

end;


// ============================================================
// PROMENA IZABRANOG REDA
// ============================================================

procedure TfraDobavljaci.qryDobavljaciAfterScroll(
  DataSet: TDataSet
);
begin

  if FNoviDobavljac then
    Exit;


  PrikaziIzabranogDobavljaca;

end;


// ============================================================
// PRIKAZ IZABRANOG DOBAVLJAČA
// ============================================================

procedure TfraDobavljaci.PrikaziIzabranogDobavljaca;
begin

  if (not FQryDobavljaci.Active) or
     FQryDobavljaci.IsEmpty then
  begin

    OcistiPolja;

    Exit;

  end;


  FIzabraniDobavljacID :=
    FQryDobavljaci.FieldByName(
      'id'
    ).AsInteger;


  edtNaziv.Text :=
    FQryDobavljaci.FieldByName(
      'naziv'
    ).AsString;


  edtEmail.Text :=
    FQryDobavljaci.FieldByName(
      'email'
    ).AsString;


  edtTelefon.Text :=
    FQryDobavljaci.FieldByName(
      'telefon'
    ).AsString;


  edtAdresa.Text :=
    FQryDobavljaci.FieldByName(
      'adresa'
    ).AsString;


  // NOVO
  // Automatski čekiramo materijale koje ovaj dobavljač dobavlja.
  UcitajMaterijaleDobavljaca(
    FIzabraniDobavljacID
  );


  FNoviDobavljac :=
    False;


  btnObrisi.Enabled :=
    True;

end;


// ============================================================
// ČIŠĆENJE POLJA
// ============================================================

procedure TfraDobavljaci.OcistiPolja;
begin

  edtNaziv.Clear;
  edtEmail.Clear;
  edtTelefon.Clear;
  edtAdresa.Clear;


  // NOVO
  OcistiIzborMaterijala;


  FIzabraniDobavljacID :=
    0;

end;


// ============================================================
// NOVI DOBAVLJAČ
// ============================================================

procedure TfraDobavljaci.btnNoviClick(
  Sender: TObject
);
begin

  FNoviDobavljac :=
    True;


  FIzabraniDobavljacID :=
    0;


  // Čisti i podatke i čekirane materijale
  OcistiPolja;


  btnObrisi.Enabled :=
    False;


  edtNaziv.SetFocus;

end;


// ============================================================
// VALIDACIJA
// ============================================================

function TfraDobavljaci.PodaciValidni: Boolean;
begin

  Result :=
    False;


  // ==========================================================
  // NAZIV
  // ==========================================================

  if Trim(
    edtNaziv.Text
  ) = '' then
  begin

    ShowMessage(
      'Unesite naziv dobavljača.'
    );

    edtNaziv.SetFocus;

    Exit;

  end;


  // ==========================================================
  // EMAIL
  // ==========================================================

  if Trim(
    edtEmail.Text
  ) <> '' then
  begin

    if Pos(
      '@',
      edtEmail.Text
    ) = 0 then
    begin

      ShowMessage(
        'Email adresa nije pravilno uneta.'
      );

      edtEmail.SetFocus;

      Exit;

    end;

  end;


  Result :=
    True;

end;


// ============================================================
// SAČUVAJ
// ============================================================

procedure TfraDobavljaci.btnSacuvajClick(
  Sender: TObject
);
var
  Q: TFDQuery;
  SacuvaniID: Integer;
begin

  if not PodaciValidni then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    try

      // ======================================================
      // TRANSAKCIJA
      // ======================================================

      frmLogin.FDConnection1.StartTransaction;


      // ======================================================
      // NOVI DOBAVLJAČ
      // ======================================================

      if FNoviDobavljac then
      begin

        Q.SQL.Text :=

          'INSERT INTO suppliers ' +
          '(name, email, phone, address) ' +

          'VALUES ' +
          '(:name, :email, :phone, :address)';


        Q.ParamByName(
          'name'
        ).AsString :=
          Trim(edtNaziv.Text);


        Q.ParamByName(
          'email'
        ).AsString :=
          Trim(edtEmail.Text);


        Q.ParamByName(
          'phone'
        ).AsString :=
          Trim(edtTelefon.Text);


        Q.ParamByName(
          'address'
        ).AsString :=
          Trim(edtAdresa.Text);


        Q.ExecSQL;


        // ====================================================
        // ID NOVOG DOBAVLJAČA
        // ====================================================

        Q.Close;

        Q.SQL.Text :=
          'SELECT last_insert_rowid() AS novi_id';


        Q.Open;


        SacuvaniID :=
          Q.FieldByName(
            'novi_id'
          ).AsInteger;


        // ====================================================
        // NOVO - ČUVAMO I NJEGOVE MATERIJALE
        // ====================================================

        SacuvajMaterijaleDobavljaca(
          SacuvaniID
        );

      end


      // ======================================================
      // IZMENA POSTOJEĆEG DOBAVLJAČA
      // ======================================================

      else
      begin

        if FIzabraniDobavljacID = 0 then
        begin

          raise Exception.Create(
            'Nije izabran dobavljač.'
          );

        end;


        SacuvaniID :=
          FIzabraniDobavljacID;


        Q.Close;


        Q.SQL.Text :=

          'UPDATE suppliers ' +

          'SET name = :name, ' +
          '    email = :email, ' +
          '    phone = :phone, ' +
          '    address = :address ' +

          'WHERE id = :id';


        Q.ParamByName(
          'name'
        ).AsString :=
          Trim(edtNaziv.Text);


        Q.ParamByName(
          'email'
        ).AsString :=
          Trim(edtEmail.Text);


        Q.ParamByName(
          'phone'
        ).AsString :=
          Trim(edtTelefon.Text);


        Q.ParamByName(
          'address'
        ).AsString :=
          Trim(edtAdresa.Text);


        Q.ParamByName(
          'id'
        ).AsInteger :=
          SacuvaniID;


        Q.ExecSQL;


        // ====================================================
        // NOVO - AŽURIRAMO I MATERIJALE
        // ====================================================

        SacuvajMaterijaleDobavljaca(
          SacuvaniID
        );

      end;


      // Ako su i dobavljač i materijali uspešno sačuvani
      frmLogin.FDConnection1.Commit;


      // ======================================================
      // PORUKA
      // ======================================================

      if FNoviDobavljac then
      begin

        ShowMessage(
          'Dobavljač i njegovi materijali su uspešno dodati.'
        );

      end
      else
      begin

        ShowMessage(
          'Podaci dobavljača su uspešno izmenjeni.'
        );

      end;


      // ======================================================
      // OSVEŽAVANJE
      // ======================================================

      FNoviDobavljac :=
        False;


      UcitajDobavljace;


      // Vraćamo selekciju na sačuvanog dobavljača
      if FQryDobavljaci.Active and
         (not FQryDobavljaci.IsEmpty) then
      begin

        FQryDobavljaci.Locate(
          'id',
          SacuvaniID,
          []
        );

      end;


    except

      on E: Exception do
      begin

        if frmLogin.FDConnection1.InTransaction then
          frmLogin.FDConnection1.Rollback;


        ShowMessage(
          'Greška prilikom čuvanja dobavljača:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// OTKAŽI
// ============================================================

procedure TfraDobavljaci.btnOtkaziClick(
  Sender: TObject
);
begin

  FNoviDobavljac :=
    False;


  if FQryDobavljaci.Active and
     (not FQryDobavljaci.IsEmpty) then
  begin

    // Vraća i podatke i originalno čekirane materijale
    PrikaziIzabranogDobavljaca;

  end
  else
  begin

    OcistiPolja;

    btnObrisi.Enabled :=
      False;

  end;

end;


// ============================================================
// DA LI SE DOBAVLJAČ VEĆ KORISTI
// ============================================================

function TfraDobavljaci.DobavljacSeKoristi(
  ADobavljacID: Integer
): Boolean;
var
  Q: TFDQuery;

  BrojPonuda: Integer;
  BrojNarudzbenica: Integer;
begin

  Result :=
    False;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT ' +

      '(SELECT COUNT(*) ' +
      ' FROM offers ' +
      ' WHERE supplier_id = :id1) ' +
      'AS broj_ponuda, ' +

      '(SELECT COUNT(*) ' +
      ' FROM orders ' +
      ' WHERE supplier_id = :id2) ' +
      'AS broj_narudzbenica';


    Q.ParamByName(
      'id1'
    ).AsInteger :=
      ADobavljacID;


    Q.ParamByName(
      'id2'
    ).AsInteger :=
      ADobavljacID;


    Q.Open;


    BrojPonuda :=
      Q.FieldByName(
        'broj_ponuda'
      ).AsInteger;


    BrojNarudzbenica :=
      Q.FieldByName(
        'broj_narudzbenica'
      ).AsInteger;


    Result :=
      (BrojPonuda > 0) or
      (BrojNarudzbenica > 0);


  finally

    Q.Free;

  end;

end;


// ============================================================
// OBRIŠI
// ============================================================

procedure TfraDobavljaci.btnObrisiClick(
  Sender: TObject
);
var
  Q: TFDQuery;

  IDZaBrisanje: Integer;
  NazivZaBrisanje: string;
begin

  if FNoviDobavljac then
  begin

    ShowMessage(
      'Novi dobavljač još nije sačuvan.'
    );

    Exit;

  end;


  if FIzabraniDobavljacID = 0 then
  begin

    ShowMessage(
      'Izaberite dobavljača kojeg želite da obrišete.'
    );

    Exit;

  end;


  IDZaBrisanje :=
    FIzabraniDobavljacID;


  NazivZaBrisanje :=
    edtNaziv.Text;


  // ==========================================================
  // ZAŠTITA ISTORIJE
  // ==========================================================

  if DobavljacSeKoristi(
    IDZaBrisanje
  ) then
  begin

    ShowMessage(
      'Dobavljača nije moguće obrisati jer se već koristi ' +
      'u ponudi ili narudžbenici.'
    );

    Exit;

  end;


  // ==========================================================
  // POTVRDA
  // ==========================================================

  if MessageDlg(

    'Da li ste sigurni da želite da obrišete dobavljača "' +
    NazivZaBrisanje +
    '"?',

    mtConfirmation,
    [mbYes, mbNo],
    0

  ) <> mrYes then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    try

      frmLogin.FDConnection1.StartTransaction;


      // ======================================================
      // PRVO VEZE SA MATERIJALIMA
      // ======================================================

      Q.SQL.Text :=

        'DELETE FROM supplier_materials ' +

        'WHERE supplier_id = :id';


      Q.ParamByName(
        'id'
      ).AsInteger :=
        IDZaBrisanje;


      Q.ExecSQL;


      // ======================================================
      // ZATIM DOBAVLJAČ
      // ======================================================

      Q.Close;


      Q.SQL.Text :=

        'DELETE FROM suppliers ' +

        'WHERE id = :id';


      Q.ParamByName(
        'id'
      ).AsInteger :=
        IDZaBrisanje;


      Q.ExecSQL;


      frmLogin.FDConnection1.Commit;


      ShowMessage(
        'Dobavljač je uspešno obrisan.'
      );


      FNoviDobavljac :=
        False;


      UcitajDobavljace;


    except

      on E: Exception do
      begin

        if frmLogin.FDConnection1.InTransaction then
          frmLogin.FDConnection1.Rollback;


        ShowMessage(
          'Greška prilikom brisanja dobavljača:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;

end.
