// ============================================================
// UČITAVANJE TABELE
// ============================================================

procedure TfraDashboard.UcitajTabelu;
begin

  FQryDashboard.Close;


  // ==========================================================
  // PODNOSILAC
  // ==========================================================

  if SameText(FUloga, 'Podnosilac') then
  begin

    lblTabelaNaslov.Caption :=
      'Moji najnoviji zahtevi';


    FQryDashboard.SQL.Text :=

      'SELECT ' +

      'CAST(' +
        '''Z-'' || ' +
        'strftime(''%Y'', r.created_at) || ' +
        '''-'' || printf(''%04d'', r.id) ' +
      'AS VARCHAR(30)) AS zahtev, ' +

      'CAST(m.name AS VARCHAR(150)) AS materijal, ' +

      'CAST(r.priority AS VARCHAR(30)) AS prioritet, ' +

      'CAST(' +
        'CASE r.status ' +
          'WHEN ''pending'' THEN ''Na čekanju'' ' +
          'WHEN ''approved'' THEN ''Odobren'' ' +
          'WHEN ''rejected'' THEN ''Odbijen'' ' +
        'END ' +
      'AS VARCHAR(50)) AS status_prikaz, ' +

      'strftime(''%d.%m.%Y'', r.needed_by) AS datum ' +

      'FROM requests r ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'WHERE r.user_id = :user_id ' +

      'ORDER BY r.created_at DESC, r.id DESC ' +

      'LIMIT 10';


    FQryDashboard.ParamByName(
      'user_id'
    ).AsInteger :=
      FKorisnikID;

  end


  // ==========================================================
  // MENADŽER
  // ==========================================================

  else if SameText(FUloga, 'Menadzer') then
  begin

    lblTabelaNaslov.Caption :=
      'Zahtevi koji čekaju odobrenje';


    FQryDashboard.SQL.Text :=

      'SELECT ' +

      'CAST(' +
        '''Z-'' || ' +
        'strftime(''%Y'', r.created_at) || ' +
        '''-'' || printf(''%04d'', r.id) ' +
      'AS VARCHAR(30)) AS zahtev, ' +

      'CAST(u.name AS VARCHAR(150)) AS podnosilac, ' +

      'CAST(m.name AS VARCHAR(150)) AS materijal, ' +

      'CAST(r.priority AS VARCHAR(30)) AS prioritet, ' +

      'strftime(''%d.%m.%Y'', r.needed_by) AS datum ' +

      'FROM requests r ' +

      'INNER JOIN users u ' +
      'ON u.id = r.user_id ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'WHERE r.status = ''pending'' ' +

      'ORDER BY ' +
        'CASE r.priority ' +
          'WHEN ''Visok'' THEN 0 ' +
          'WHEN ''Srednji'' THEN 1 ' +
          'ELSE 2 ' +
        'END, ' +
        'r.needed_by ASC ' +

      'LIMIT 10';

  end


  // ==========================================================
  // NABAVKA
  // ==========================================================

  else if SameText(FUloga, 'Nabavka') then
  begin

    lblTabelaNaslov.Caption :=
      'Odobreni zahtevi za obradu';


    FQryDashboard.SQL.Text :=

      'SELECT ' +

      'CAST(' +
        '''Z-'' || ' +
        'strftime(''%Y'', r.created_at) || ' +
        '''-'' || printf(''%04d'', r.id) ' +
      'AS VARCHAR(30)) AS zahtev, ' +

      'CAST(m.name AS VARCHAR(150)) AS materijal, ' +

      'COUNT(o.id) AS broj_ponuda, ' +

      'CAST(' +
        'CASE ' +
          'WHEN SUM(CASE WHEN o.selected = 1 THEN 1 ELSE 0 END) > 0 ' +
          'THEN ''Da'' ' +
          'ELSE ''Ne'' ' +
        'END ' +
      'AS VARCHAR(20)) AS izabrana_ponuda, ' +

      'strftime(''%d.%m.%Y'', r.needed_by) AS datum ' +

      'FROM requests r ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'LEFT JOIN offers o ' +
      'ON o.request_id = r.id ' +

      'WHERE r.status = ''approved'' ' +

      'AND NOT EXISTS (' +
        'SELECT 1 ' +
        'FROM orders ord ' +
        'WHERE ord.request_id = r.id' +
      ') ' +

      'GROUP BY ' +
        'r.id, r.created_at, m.name, r.needed_by ' +

      'ORDER BY r.needed_by ASC ' +

      'LIMIT 10';

  end


  // ==========================================================
  // MAGACIONER
  // ==========================================================

  else if SameText(FUloga, 'Magacioner') then
  begin

    lblTabelaNaslov.Caption :=
      'Očekivane isporuke';


    FQryDashboard.SQL.Text :=

      'SELECT ' +

      'CAST(' +
        '''N-'' || printf(''%04d'', ord.id) ' +
      'AS VARCHAR(30)) AS narudzbenica, ' +

      'CAST(s.name AS VARCHAR(150)) AS dobavljac, ' +

      'CAST(m.name AS VARCHAR(150)) AS materijal, ' +

      'strftime(''%d.%m.%Y'', ord.expected_date) AS datum, ' +

      'CAST(' +
        'CASE ord.status ' +
          'WHEN ''sent'' THEN ''Poslata'' ' +
          'WHEN ''confirmed'' THEN ''Potvrđena'' ' +
          'WHEN ''in_progress'' THEN ''U toku'' ' +
          'WHEN ''delivered'' THEN ''Isporučena'' ' +
          'ELSE ord.status ' +
        'END ' +
      'AS VARCHAR(50)) AS status_prikaz ' +

      'FROM orders ord ' +

      'INNER JOIN requests r ' +
      'ON r.id = ord.request_id ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'INNER JOIN suppliers s ' +
      'ON s.id = ord.supplier_id ' +

      'WHERE ord.status IN (' +
        '''sent'', ' +
        '''confirmed'', ' +
        '''in_progress'', ' +
        '''delivered''' +
      ') ' +

      'ORDER BY ord.expected_date ASC ' +

      'LIMIT 10';

  end


  // ==========================================================
  // ADMINISTRATOR
  // ==========================================================

  else if SameText(FUloga, 'Administrator') then
  begin

    lblTabelaNaslov.Caption :=
      'Korisnici sistema';


    FQryDashboard.SQL.Text :=

      'SELECT ' +

      'CAST(username AS VARCHAR(100)) AS username, ' +

      'CAST(name AS VARCHAR(150)) AS ime, ' +

      'CAST(role AS VARCHAR(50)) AS uloga, ' +

      'CAST(' +
        'CASE ' +
          'WHEN active = 1 THEN ''Aktivan'' ' +
          'ELSE ''Neaktivan'' ' +
        'END ' +
      'AS VARCHAR(30)) AS status_prikaz ' +

      'FROM users ' +

      'ORDER BY id DESC ' +

      'LIMIT 10';

  end;


  try

    FQryDashboard.Open;

    PodesiKolone;


  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja Dashboard-a:' +
        sLineBreak +
        E.Message
      );

    end;

  end;

end;


