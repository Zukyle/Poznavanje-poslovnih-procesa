// ============================================================
// CONSTRUCTOR
// ============================================================

constructor TfraDashboard.Create(
  AOwner: TComponent
);
begin
  inherited Create(AOwner);


  // ==========================================================
  // QUERY
  // ==========================================================

  FQryDashboard :=
    TFDQuery.Create(Self);

  FQryDashboard.Connection :=
    frmLogin.FDConnection1;


  // ==========================================================
  // DATASOURCE
  // ==========================================================

  FDsDashboard :=
    TDataSource.Create(Self);

  FDsDashboard.DataSet :=
    FQryDashboard;


  dbgDashboard.DataSource :=
    FDsDashboard;

  dbgDashboard.ReadOnly :=
    True;

  dbgDashboard.Options :=
    dbgDashboard.Options + [dgRowSelect];


  // ==========================================================
  // KARTICE
  // ==========================================================

  pnlKartica1.BevelOuter := bvNone;
  pnlKartica2.BevelOuter := bvNone;
  pnlKartica3.BevelOuter := bvNone;
  pnlKartica4.BevelOuter := bvNone;


  pnlKartica1.Color := clWhite;
  pnlKartica2.Color := clWhite;
  pnlKartica3.Color := clWhite;
  pnlKartica4.Color := clWhite;


  pnlKartica1.ParentBackground := False;
  pnlKartica2.ParentBackground := False;
  pnlKartica3.ParentBackground := False;
  pnlKartica4.ParentBackground := False;


  // ==========================================================
  // SHAPE - 60 x 60
  // ==========================================================

  shpIkona1.Shape := stCircle;
  shpIkona2.Shape := stCircle;
  shpIkona3.Shape := stCircle;
  shpIkona4.Shape := stCircle;


  shpIkona1.Width := 60;
  shpIkona1.Height := 60;

  shpIkona2.Width := 60;
  shpIkona2.Height := 60;

  shpIkona3.Width := 60;
  shpIkona3.Height := 60;

  shpIkona4.Width := 60;
  shpIkona4.Height := 60;


  shpIkona1.Pen.Style := psClear;
  shpIkona2.Pen.Style := psClear;
  shpIkona3.Pen.Style := psClear;
  shpIkona4.Pen.Style := psClear;


  // ==========================================================
  // IKONE - 48 x 48
  // ==========================================================

  imgKartica1.Width := 48;
  imgKartica1.Height := 48;

  imgKartica2.Width := 48;
  imgKartica2.Height := 48;

  imgKartica3.Width := 48;
  imgKartica3.Height := 48;

  imgKartica4.Width := 48;
  imgKartica4.Height := 48;


  imgKartica1.Proportional := True;
  imgKartica2.Proportional := True;
  imgKartica3.Proportional := True;
  imgKartica4.Proportional := True;


  imgKartica1.Center := True;
  imgKartica2.Center := True;
  imgKartica3.Center := True;
  imgKartica4.Center := True;


  imgKartica1.BringToFront;
  imgKartica2.BringToFront;
  imgKartica3.BringToFront;
  imgKartica4.BringToFront;


  // ==========================================================
  // VREDNOSTI
  // ==========================================================

  lblKartica1Vrednost.Font.Style := [fsBold];
  lblKartica2Vrednost.Font.Style := [fsBold];
  lblKartica3Vrednost.Font.Style := [fsBold];
  lblKartica4Vrednost.Font.Style := [fsBold];


  lblKartica1Vrednost.StyleElements :=
    lblKartica1Vrednost.StyleElements - [seFont];

  lblKartica2Vrednost.StyleElements :=
    lblKartica2Vrednost.StyleElements - [seFont];

  lblKartica3Vrednost.StyleElements :=
    lblKartica3Vrednost.StyleElements - [seFont];

  lblKartica4Vrednost.StyleElements :=
    lblKartica4Vrednost.StyleElements - [seFont];


  // ==========================================================
  // KLIKOVI
  // ==========================================================

  PoveziKlikoveKartica;


  FKorisnikID := 0;
  FUloga := '';

end;


// ============================================================
// PRIKAŽI DASHBOARD
// ============================================================

procedure TfraDashboard.PrikaziZaKorisnika(
  AKorisnikID: Integer;
  const AUloga: string
);
begin

  FKorisnikID :=
    AKorisnikID;

  FUloga :=
    AUloga;


  Osvezi;

end;


// ============================================================
// OSVEŽAVANJE
// ============================================================

procedure TfraDashboard.Osvezi;
begin

  if FUloga = '' then
    Exit;


  PodesiDashboard;

  UcitajTabelu;

end;


// ============================================================
// DASHBOARD PREMA ULOZI
// ============================================================

procedure TfraDashboard.PodesiDashboard;
begin

  if SameText(
    FUloga,
    'Podnosilac'
  ) then
    PodesiPodnosioca


  else if SameText(
    FUloga,
    'Menadzer'
  ) then
    PodesiMenadzera


  else if SameText(
    FUloga,
    'Nabavka'
  ) then
    PodesiNabavku


  else if SameText(
    FUloga,
    'Magacioner'
  ) then
    PodesiMagacionera


  else if SameText(
    FUloga,
    'Administrator'
  ) then
    PodesiAdministratora;

end;


