// ============================================================
// PODEŠAVANJE JEDNE KARTICE
// ============================================================

procedure TfraDashboard.PodesiKarticu(
  AKartica: Integer;
  const ANaslov: string;
  const AOpis: string;
  AVrednost: Integer;
  const AIkonica: string;
  ABoja: TColor;
  ASvetlaBoja: TColor
);
var
  Naslov: TLabel;
  Vrednost: TLabel;
  Opis: TLabel;

  Shp: TShape;
  Img: TImage;
begin

  Naslov := nil;
  Vrednost := nil;
  Opis := nil;
  Shp := nil;
  Img := nil;


  case AKartica of

    1:
    begin
      Naslov := lblKartica1Naslov;
      Vrednost := lblKartica1Vrednost;
      Opis := lblKartica1Opis;
      Shp := shpIkona1;
      Img := imgKartica1;
    end;


    2:
    begin
      Naslov := lblKartica2Naslov;
      Vrednost := lblKartica2Vrednost;
      Opis := lblKartica2Opis;
      Shp := shpIkona2;
      Img := imgKartica2;
    end;


    3:
    begin
      Naslov := lblKartica3Naslov;
      Vrednost := lblKartica3Vrednost;
      Opis := lblKartica3Opis;
      Shp := shpIkona3;
      Img := imgKartica3;
    end;


    4:
    begin
      Naslov := lblKartica4Naslov;
      Vrednost := lblKartica4Vrednost;
      Opis := lblKartica4Opis;
      Shp := shpIkona4;
      Img := imgKartica4;
    end;

  end;


  if not Assigned(Naslov) then
    Exit;


  Naslov.Caption :=
    ANaslov;


  Vrednost.Caption :=
    IntToStr(
      AVrednost
    );


  Opis.Caption :=
    AOpis;


  // ==========================================================
  // BROJ = ISTA BOJA KAO IKONICA
  // ==========================================================

  Vrednost.StyleElements :=
    Vrednost.StyleElements - [seFont];

  Vrednost.Font.Color :=
    ABoja;


  // ==========================================================
  // SHAPE = SVETLA VARIJANTA ISTE BOJE
  // ==========================================================

  Shp.Brush.Color :=
    ASvetlaBoja;

  Shp.Pen.Style :=
    psClear;


  UcitajIkonicu(
    Img,
    AIkonica
  );


  Img.BringToFront;

end;


// ============================================================
// PUTANJA IKONICE
// ============================================================

function TfraDashboard.PronadjiIkonicu(
  const AFajl: string
): string;
var
  Base: string;
  P: string;
begin

  Result := '';


  Base :=
    ExtractFilePath(
      ParamStr(0)
    );


  // ==========================================================
  // 1. assets pored EXE-a
  // ==========================================================

  P :=
    Base +
    'assets\icons\' +
    AFajl;


  if FileExists(P) then
  begin
    Result := P;
    Exit;
  end;


  // ==========================================================
  // 2. Project\Win32\Debug -> Project\assets\icons
  // ==========================================================

  P :=
    ExpandFileName(
      Base +
      '..\..\assets\icons\' +
      AFajl
    );


  if FileExists(P) then
  begin
    Result := P;
    Exit;
  end;


  // ==========================================================
  // 3. Dodatna rezerva
  // ==========================================================

  P :=
    ExpandFileName(
      Base +
      '..\..\..\assets\icons\' +
      AFajl
    );


  if FileExists(P) then
    Result := P;

end;


// ============================================================
// UČITAJ IKONICU
// ============================================================

procedure TfraDashboard.UcitajIkonicu(
  AImage: TImage;
  const AFajl: string
);
var
  Putanja: string;
begin

  Putanja :=
    PronadjiIkonicu(
      AFajl
    );


  AImage.Picture.Assign(nil);


  if Putanja <> '' then
  begin

    try

      AImage.Picture.LoadFromFile(
        Putanja
      );

    except
      // Ako jedna ikonica nedostaje,
