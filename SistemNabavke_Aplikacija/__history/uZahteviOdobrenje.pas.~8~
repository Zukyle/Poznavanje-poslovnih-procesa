unit uZahteviOdobrenje;

interface

uses
  Winapi.Windows,
  System.SysUtils,
  System.Classes,

  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.StdCtrls,
  Vcl.ExtCtrls,
  Vcl.Imaging.pngimage,
  Vcl.Grids,
  Vcl.DBGrids,

  Data.DB,

  FireDAC.Stan.Intf,
  FireDAC.Stan.Option,
  FireDAC.Stan.Param,
  FireDAC.Stan.Error,
  FireDAC.DatS,
  FireDAC.Phys.Intf,
  FireDAC.DApt.Intf,
  FireDAC.Stan.Async,
  FireDAC.DApt,
  FireDAC.Comp.DataSet,
  FireDAC.Comp.Client;

type
  TfraZahteviOdobrenje = class(TFrame)

    pnlHeader: TPanel;
    lblNaslov: TLabel;
    lblOpis: TLabel;

    pnlSadrzaj: TPanel;

    // ========================================================
    // STATISTIKA
    // ========================================================

    pnlStatistika: TPanel;

    pnlCekanje: TPanel;
    lblCekanjeNaslov: TLabel;
    lblCekanjeBroj: TLabel;
    lblCekanjeOpis: TLabel;

    pnlOdobreni: TPanel;
    lblOdobreniNaslov: TLabel;
    lblOdobreniBroj: TLabel;
    lblOdobreniOpis: TLabel;

    pnlHitni: TPanel;
    lblHitniNaslov: TLabel;
    lblHitniBroj: TLabel;
    lblHitniOpis: TLabel;

    // NOVO - TShape umesto panela iza ikonica
    shpIkonaCekanje: TShape;
    imgCekanje: TImage;

    shpIkonaHitno: TShape;
    imgHitni: TImage;

    Shape1: TShape;
    imgOdobreni: TImage;

    // ========================================================
    // TABELA
    // ========================================================

    pnlTabela: TPanel;
    lblTabelaNaslov: TLabel;
    dbgZahtevi: TDBGrid;

    qryZahtevi: TFDQuery;
    dsZahtevi: TDataSource;

    // ========================================================
    // DETALJI
    // ========================================================

    pnlDetalji: TPanel;
    lblDetaljiNaslov: TLabel;
    lblIDZahteva: TLabel;

    lblMaterijalNaslov: TLabel;
    lblMaterijalVrednost: TLabel;

    lblKolicinaNaslov: TLabel;
    lblKolicinaVrednost: TLabel;

    lblPrioritetNaslov: TLabel;
    lblPrioritetVrednost: TLabel;

    lblDatumNaslov: TLabel;
    lblDatumVrednost: TLabel;

    lblRazlogNaslov: TLabel;

    lblPodnosilacNaslov: TLabel;
    lblPodnosilacVrednost: TLabel;

    memRazlog: TMemo;

    lblKomentarNaslov: TLabel;
    memKomentar: TMemo;

    btnOdbij: TButton;
    btnOdobri: TButton;

  private

    // Obojene zamene za obične TButton kontrole
    FPnlOdbijAkcija: TPanel;
    FPnlOdobriAkcija: TPanel;

    procedure UcitajStatistiku;
    procedure UcitajZahteve;

    procedure PodesiKolone;

    procedure PrikaziIzabraniZahtev;
    procedure OcistiDetalje;

    procedure qryZahteviAfterScroll(DataSet: TDataSet);

    procedure btnOdobriClick(Sender: TObject);
    procedure btnOdbijClick(Sender: TObject);

    procedure OdluciZahtev(const NoviStatus: string);

    // ========================================================
    // VIZUELNI DEO
    // ========================================================

    function BojaPrioriteta(
      const APrioritet: string
    ): TColor;

    procedure dbgZahteviDrawColumnCell(
      Sender: TObject;
      const Rect: TRect;
      DataCol: Integer;
      Column: TColumn;
      State: TGridDrawState
    );

    procedure KreirajAkcionaDugmad;

    procedure PostaviAkcionaDugmad(
      AEnabled: Boolean
    );

  public

    constructor Create(AOwner: TComponent); override;

    procedure Osvezi;

  end;

implementation

uses
  uLogin;

{$R *.dfm}


// ============================================================
// KREIRANJE FRAME-A
// ============================================================

constructor TfraZahteviOdobrenje.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);


  // ==========================================================
  // POVEZIVANJE SA BAZOM
  // ==========================================================

  qryZahtevi.Connection :=
    frmLogin.FDConnection1;

  dsZahtevi.DataSet :=
    qryZahtevi;

  dbgZahtevi.DataSource :=
    dsZahtevi;


  // ==========================================================
  // DBGRID
  // ==========================================================

  dbgZahtevi.ReadOnly := True;

  dbgZahtevi.Options :=
    dbgZahtevi.Options + [dgRowSelect];

  // Bojenje prioriteta
  dbgZahtevi.OnDrawColumnCell :=
    dbgZahteviDrawColumnCell;


  // ==========================================================
  // DOGAĐAJI
  // ==========================================================

  qryZahtevi.AfterScroll :=
    qryZahteviAfterScroll;


  // ==========================================================
  // MEMO
  // ==========================================================

  memRazlog.ReadOnly := True;


  // ==========================================================
  // BOJE STATISTIKE
  // ==========================================================

  lblCekanjeBroj.StyleElements :=
    lblCekanjeBroj.StyleElements - [seFont];

  lblHitniBroj.StyleElements :=
    lblHitniBroj.StyleElements - [seFont];

  lblOdobreniBroj.StyleElements :=
    lblOdobreniBroj.StyleElements - [seFont];


  // Na čekanju - narandžasta
  lblCekanjeBroj.Font.Color :=
    RGB(245, 158, 11);

  // Hitni - crvena
  lblHitniBroj.Font.Color :=
    RGB(220, 38, 38);

  // Odobreni - zelena
  lblOdobreniBroj.Font.Color :=
    RGB(22, 163, 74);


  // ==========================================================
  // PRIORITET U DETALJIMA
  // ==========================================================

  lblPrioritetVrednost.StyleElements :=
    lblPrioritetVrednost.StyleElements - [seFont];

  lblPrioritetVrednost.Font.Style :=
    [fsBold];


  // ==========================================================
  // CRVENO I ZELENO DUGME
  // ==========================================================

  KreirajAkcionaDugmad;


  // ==========================================================
  // POČETNO STANJE
  // ==========================================================

  OcistiDetalje;

  Osvezi;
end;


// ============================================================
// BOJA PRIORITETA
// ============================================================

function TfraZahteviOdobrenje.BojaPrioriteta(
  const APrioritet: string
): TColor;
begin

  if SameText(APrioritet, 'Visok') then
  begin
    Result := RGB(220, 38, 38);
  end

  else if SameText(APrioritet, 'Srednji') then
  begin
    Result := RGB(245, 158, 11);
  end

  else if SameText(APrioritet, 'Nizak') then
  begin
    Result := RGB(22, 163, 74);
  end

  else
  begin
    Result := clWindowText;
  end;

end;


// ============================================================
// KREIRANJE OBOJENIH AKCIONIH DUGMADI
// ============================================================

procedure TfraZahteviOdobrenje.KreirajAkcionaDugmad;
begin

  // ==========================================================
  // ODBIJ
  // ==========================================================

  FPnlOdbijAkcija :=
    TPanel.Create(Self);

  FPnlOdbijAkcija.Parent :=
    pnlDetalji;

  FPnlOdbijAkcija.SetBounds(
    btnOdbij.Left,
    btnOdbij.Top,
    btnOdbij.Width,
    btnOdbij.Height
  );

  FPnlOdbijAkcija.Caption :=
    'Odbij';

  FPnlOdbijAkcija.BevelOuter :=
    bvNone;

  FPnlOdbijAkcija.ParentBackground :=
    False;

  FPnlOdbijAkcija.StyleElements :=
    FPnlOdbijAkcija.StyleElements -
    [seClient, seFont, seBorder];

  FPnlOdbijAkcija.Color :=
    RGB(220, 38, 38);

  FPnlOdbijAkcija.Font.Color :=
    clWhite;

  FPnlOdbijAkcija.Font.Style :=
    [fsBold];

  FPnlOdbijAkcija.Cursor :=
    crHandPoint;

  FPnlOdbijAkcija.OnClick :=
    btnOdbijClick;


  // ==========================================================
  // ODOBRI
  // ==========================================================

  FPnlOdobriAkcija :=
    TPanel.Create(Self);

  FPnlOdobriAkcija.Parent :=
    pnlDetalji;

  FPnlOdobriAkcija.SetBounds(
    btnOdobri.Left,
    btnOdobri.Top,
    btnOdobri.Width,
    btnOdobri.Height
  );

  FPnlOdobriAkcija.Caption :=
    'Odobri';

  FPnlOdobriAkcija.BevelOuter :=
    bvNone;

  FPnlOdobriAkcija.ParentBackground :=
    False;

  FPnlOdobriAkcija.StyleElements :=
    FPnlOdobriAkcija.StyleElements -
    [seClient, seFont, seBorder];

  FPnlOdobriAkcija.Color :=
    RGB(22, 163, 74);

  FPnlOdobriAkcija.Font.Color :=
    clWhite;

  FPnlOdobriAkcija.Font.Style :=
    [fsBold];

  FPnlOdobriAkcija.Cursor :=
    crHandPoint;

  FPnlOdobriAkcija.OnClick :=
    btnOdobriClick;


  // Originalni TButton se više ne prikazuje
  btnOdbij.Visible := False;
  btnOdobri.Visible := False;


  FPnlOdbijAkcija.BringToFront;
  FPnlOdobriAkcija.BringToFront;
end;


// ============================================================
// ENABLE / DISABLE AKCIONIH DUGMADI
// ============================================================

procedure TfraZahteviOdobrenje.PostaviAkcionaDugmad(
  AEnabled: Boolean
);
begin

  if Assigned(FPnlOdbijAkcija) then
  begin

    FPnlOdbijAkcija.Enabled :=
      AEnabled;

    if AEnabled then
    begin
      FPnlOdbijAkcija.Color :=
        RGB(220, 38, 38);

      FPnlOdbijAkcija.Cursor :=
        crHandPoint;
    end
    else
    begin
      FPnlOdbijAkcija.Color :=
        RGB(170, 170, 170);

      FPnlOdbijAkcija.Cursor :=
        crDefault;
    end;

  end;


  if Assigned(FPnlOdobriAkcija) then
  begin

    FPnlOdobriAkcija.Enabled :=
      AEnabled;

    if AEnabled then
    begin
      FPnlOdobriAkcija.Color :=
        RGB(22, 163, 74);

      FPnlOdobriAkcija.Cursor :=
        crHandPoint;
    end
    else
    begin
      FPnlOdobriAkcija.Color :=
        RGB(170, 170, 170);

      FPnlOdobriAkcija.Cursor :=
        crDefault;
    end;

  end;

end;


// ============================================================
// OSVEŽAVANJE
// ============================================================

procedure TfraZahteviOdobrenje.Osvezi;
begin
  UcitajStatistiku;
  UcitajZahteve;
end;


// ============================================================
// STATISTIKA
// ============================================================

procedure TfraZahteviOdobrenje.UcitajStatistiku;
var
  Q: TFDQuery;
begin

  Q := TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT ' +

      'COUNT(CASE ' +
      'WHEN status = ''pending'' ' +
      'THEN 1 END) AS cekanje, ' +

      'COUNT(CASE ' +
      'WHEN status = ''pending'' ' +
      'AND priority = ''Visok'' ' +
      'THEN 1 END) AS hitni, ' +

      'COUNT(CASE ' +
      'WHEN status = ''approved'' ' +
      'THEN 1 END) AS odobreni ' +

      'FROM requests';


    try

      Q.Open;


      lblCekanjeBroj.Caption :=
        Q.FieldByName('cekanje').AsString;

      lblHitniBroj.Caption :=
        Q.FieldByName('hitni').AsString;

      lblOdobreniBroj.Caption :=
        Q.FieldByName('odobreni').AsString;


    except

      on E: Exception do
      begin
        ShowMessage(
          'Greška prilikom učitavanja statistike:' +
          sLineBreak +
          E.Message
        );
      end;

    end;

  finally

    Q.Free;

  end;

end;


// ============================================================
// UČITAVANJE PENDING ZAHTEVA
// ============================================================

procedure TfraZahteviOdobrenje.UcitajZahteve;
begin

  qryZahtevi.Close;


  qryZahtevi.SQL.Text :=

    'SELECT ' +

    // Interni ID
    'r.id, ' +

    // Šifra
    '''Z-'' || ' +
    'strftime(''%Y'', r.created_at) || ' +
    '''-'' || ' +
    'printf(''%04d'', r.id) AS sifra, ' +

    // Podnosilac
    'CAST(u.name AS VARCHAR(100)) ' +
    'AS podnosilac, ' +

    // Materijal
    'CAST(m.name AS VARCHAR(100)) ' +
    'AS materijal, ' +

    // Količina
    'CAST(' +
    'printf(''%g'', r.quantity) || ' +
    ''' '' || m.unit ' +
    'AS VARCHAR(50)) ' +
    'AS kolicina, ' +

    // Prioritet
    'CAST(r.priority AS VARCHAR(30)) ' +
    'AS prioritet, ' +

    // Datum potrebe
    'strftime(''%d.%m.%Y'', r.needed_by) ' +
    'AS datum_potrebe, ' +

    // Datum kreiranja
    'strftime(''%d.%m.%Y'', r.created_at) ' +
    'AS datum_kreiranja, ' +

    // Obrazloženje
    'CAST(r.reason AS VARCHAR(1000)) ' +
    'AS reason, ' +

    // Komentar menadžera
    'CAST(r.manager_comment AS VARCHAR(1000)) ' +
    'AS manager_comment, ' +

    // Status
    'CAST(r.status AS VARCHAR(30)) ' +
    'AS status_raw ' +

    'FROM requests r ' +

    'INNER JOIN materials m ' +
    'ON m.id = r.material_id ' +

    'INNER JOIN users u ' +
    'ON u.id = r.user_id ' +

    // Samo pending
    'WHERE r.status = ''pending'' ' +

    // Prioritet sortiranja
    'ORDER BY ' +

    'CASE r.priority ' +
    'WHEN ''Visok'' THEN 1 ' +
    'WHEN ''Srednji'' THEN 2 ' +
    'WHEN ''Nizak'' THEN 3 ' +
    'ELSE 4 ' +
    'END, ' +

    'r.created_at DESC, ' +
    'r.id DESC';


  try

    qryZahtevi.Open;

    PodesiKolone;

    PrikaziIzabraniZahtev;


  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja zahteva:' +
        sLineBreak +
        E.Message
      );

      OcistiDetalje;

    end;

  end;

end;


// ============================================================
// KOLONE
// ============================================================

procedure TfraZahteviOdobrenje.PodesiKolone;
begin

  dbgZahtevi.Columns.Clear;


  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'sifra';
    Title.Caption := 'ID';
    Width := 105;
  end;


  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'podnosilac';
    Title.Caption := 'Podnosilac';
    Width := 140;
  end;


  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'materijal';
    Title.Caption := 'Materijal';
    Width := 150;
  end;


  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'kolicina';
    Title.Caption := 'Količina';
    Width := 80;
  end;


  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'prioritet';
    Title.Caption := 'Prioritet';
    Width := 80;
  end;


  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'datum_potrebe';
    Title.Caption := 'Potrebno do';
    Width := 95;
  end;

end;


// ============================================================
// BOJENJE PRIORITETA U TABELI
// ============================================================

procedure TfraZahteviOdobrenje.dbgZahteviDrawColumnCell(
  Sender: TObject;
  const Rect: TRect;
  DataCol: Integer;
  Column: TColumn;
  State: TGridDrawState
);
var
  Prioritet: string;
  TekstRect: TRect;
begin

  if not Assigned(Column.Field) then
  begin

    dbgZahtevi.DefaultDrawColumnCell(
      Rect,
      DataCol,
      Column,
      State
    );

    Exit;

  end;


  // Sve osim prioriteta se crta normalno
  if not SameText(
    Column.Field.FieldName,
    'prioritet'
  ) then
  begin

    dbgZahtevi.DefaultDrawColumnCell(
      Rect,
      DataCol,
      Column,
      State
    );

    Exit;

  end;


  Prioritet :=
    Column.Field.AsString;


  // Nema plave pozadine kod prioriteta
  dbgZahtevi.Canvas.Brush.Color :=
    dbgZahtevi.Color;

  dbgZahtevi.Canvas.FillRect(
    Rect
  );


  // Boja teksta prema prioritetu
  dbgZahtevi.Canvas.Font.Color :=
    BojaPrioriteta(Prioritet);

  dbgZahtevi.Canvas.Font.Style :=
    [fsBold];


  TekstRect := Rect;

  Inc(
    TekstRect.Left,
    4
  );


  dbgZahtevi.Canvas.TextRect(
    TekstRect,
    TekstRect.Left,
    TekstRect.Top + 2,
    Prioritet
  );


  // Vraćamo normalan font
  dbgZahtevi.Canvas.Font.Color :=
    dbgZahtevi.Font.Color;

  dbgZahtevi.Canvas.Font.Style :=
    [];

end;


// ============================================================
// PROMENA REDA
// ============================================================

procedure TfraZahteviOdobrenje.qryZahteviAfterScroll(
  DataSet: TDataSet
);
begin
  PrikaziIzabraniZahtev;
end;


// ============================================================
// PRIKAZ DETALJA
// ============================================================

procedure TfraZahteviOdobrenje.PrikaziIzabraniZahtev;
var
  Prioritet: string;
begin

  if (not qryZahtevi.Active) or
     qryZahtevi.IsEmpty then
  begin

    OcistiDetalje;
    Exit;

  end;


  lblIDZahteva.Caption :=
    qryZahtevi.FieldByName('sifra').AsString;


  lblMaterijalVrednost.Caption :=
    qryZahtevi.FieldByName('materijal').AsString;


  lblKolicinaVrednost.Caption :=
    qryZahtevi.FieldByName('kolicina').AsString;


  Prioritet :=
    qryZahtevi.FieldByName('prioritet').AsString;


  lblPrioritetVrednost.Caption :=
    Prioritet;

  lblPrioritetVrednost.Font.Color :=
    BojaPrioriteta(Prioritet);


  lblDatumVrednost.Caption :=
    qryZahtevi.FieldByName('datum_potrebe').AsString;


  lblPodnosilacVrednost.Caption :=
    qryZahtevi.FieldByName('podnosilac').AsString;


  memRazlog.Lines.Text :=
    qryZahtevi.FieldByName('reason').AsString;


  memKomentar.Lines.Text :=
    qryZahtevi.FieldByName('manager_comment').AsString;


  PostaviAkcionaDugmad(True);

end;


// ============================================================
// ČIŠĆENJE DETALJA
// ============================================================

procedure TfraZahteviOdobrenje.OcistiDetalje;
begin

  lblIDZahteva.Caption := '-';

  lblMaterijalVrednost.Caption := '-';

  lblKolicinaVrednost.Caption := '-';

  lblPrioritetVrednost.Caption := '-';
  lblPrioritetVrednost.Font.Color := clWindowText;

  lblDatumVrednost.Caption := '-';

  lblPodnosilacVrednost.Caption := '-';

  memRazlog.Clear;

  memKomentar.Clear;

  PostaviAkcionaDugmad(False);

end;


// ============================================================
// ODOBRI
// ============================================================

procedure TfraZahteviOdobrenje.btnOdobriClick(
  Sender: TObject
);
begin
  OdluciZahtev('approved');
end;


// ============================================================
// ODBIJ
// ============================================================

procedure TfraZahteviOdobrenje.btnOdbijClick(
  Sender: TObject
);
begin

  if Trim(memKomentar.Text) = '' then
  begin

    ShowMessage(
      'Unesite razlog odbijanja zahteva.'
    );

    memKomentar.SetFocus;

    Exit;

  end;


  OdluciZahtev('rejected');

end;


// ============================================================
// ODLUKA MENADŽERA
// ============================================================

procedure TfraZahteviOdobrenje.OdluciZahtev(
  const NoviStatus: string
);
var
  Q: TFDQuery;

  ZahtevID: Integer;
  SifraZahteva: string;

  Poruka: string;
begin

  if (not qryZahtevi.Active) or
     qryZahtevi.IsEmpty then
  begin

    ShowMessage(
      'Nije izabran zahtev.'
    );

    Exit;

  end;


  ZahtevID :=
    qryZahtevi.FieldByName('id').AsInteger;


  SifraZahteva :=
    qryZahtevi.FieldByName('sifra').AsString;


  if SameText(NoviStatus, 'approved') then
  begin

    Poruka :=
      'Da li ste sigurni da želite da odobrite zahtev ' +
      SifraZahteva +
      '?';

  end
  else
  begin

    Poruka :=
      'Da li ste sigurni da želite da odbijete zahtev ' +
      SifraZahteva +
      '?';

  end;


  if MessageDlg(
    Poruka,
    mtConfirmation,
    [mbYes, mbNo],
    0
  ) <> mrYes then
    Exit;


  Q := TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'UPDATE requests ' +

      'SET status = :status, ' +

      'manager_comment = :manager_comment ' +

      'WHERE id = :id ' +

      'AND status = ''pending''';


    Q.ParamByName('status').AsString :=
      NoviStatus;


    Q.ParamByName('manager_comment').AsString :=
      Trim(memKomentar.Text);


    Q.ParamByName('id').AsInteger :=
      ZahtevID;


    try

      Q.ExecSQL;


      if Q.RowsAffected = 0 then
      begin

        ShowMessage(
          'Zahtev više ne čeka odobrenje.' +
          sLineBreak +
          'Lista će biti osvežena.'
        );

        Osvezi;

        Exit;

      end;


      if SameText(NoviStatus, 'approved') then
      begin

        ShowMessage(
          'Zahtev ' +
          SifraZahteva +
          ' je uspešno odobren.'
        );

      end
      else
      begin

        ShowMessage(
          'Zahtev ' +
          SifraZahteva +
          ' je odbijen.'
        );

      end;


      Osvezi;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom obrade zahteva:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;

end.
