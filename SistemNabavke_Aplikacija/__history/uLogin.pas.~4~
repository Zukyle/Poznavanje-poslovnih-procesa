unit uLogin;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, FireDAC.Stan.Intf,
  FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf, FireDAC.Phys.Intf,
  FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys,
  FireDAC.VCLUI.Wait, FireDAC.Stan.Param, FireDAC.DatS, FireDAC.DApt.Intf,
  FireDAC.DApt, FireDAC.Stan.ExprFuncs, FireDAC.Phys.SQLiteWrapper.Stat,
  FireDAC.Phys.SQLiteDef, FireDAC.Phys.SQLite, Data.DB, FireDAC.Comp.DataSet,
  FireDAC.Comp.Client;

type
  TfrmLogin = class(TForm)
    lblKorisnickoIme: TLabel;
    lblLozinka: TLabel;
    edtKorisnickoIme: TEdit;
    edtLozinka: TEdit;
    btnPrijaviSe: TButton;
    FDConnection1: TFDConnection;
    FDQuery1: TFDQuery;
    FDPhysSQLiteDriverLink1: TFDPhysSQLiteDriverLink;
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmLogin: TfrmLogin;

implementation

{$R *.dfm}

procedure TfrmLogin.FormCreate(Sender: TObject);
var
  PutanjaBaze: string;
begin
  // Baza se nalazi pored .exe fajla
  PutanjaBaze :=
    ExtractFilePath(ParamStr(0)) + 'nabavke.db';

  // Provera da li baza postoji
  if not FileExists(PutanjaBaze) then
  begin
    ShowMessage(
      'Baza nije pronađena:' +
      sLineBreak +
      PutanjaBaze
    );

    Exit;
  end;

  // Podešavanje SQLite konekcije
  FDConnection1.Connected := False;
  FDConnection1.Params.Clear;

  FDConnection1.Params.Add('DriverID=SQLite');
  FDConnection1.Params.Add('Database=' + PutanjaBaze);

  FDConnection1.LoginPrompt := False;

  // Otvaranje konekcije
  FDConnection1.Connected := True;

  // Query koristi ovu konekciju
  FDQuery1.Connection := FDConnection1;

  // Privremeno - samo da proverimo da radi
  ShowMessage('Uspešno povezivanje sa bazom!');
end;
end.
