unit uZahteviOdobrenje;

interface

uses
  Winapi.Windows,
  Winapi.Messages,
  System.SysUtils,
  System.Variants,
  System.Classes,

  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.StdCtrls,
  Vcl.ExtCtrls,
  Vcl.Imaging.pngimage,
  Vcl.Grids,
  Vcl.DBGrids,

  Data.DB,

  FireDAC.Stan.Intf,
  FireDAC.Stan.Option,
  FireDAC.Stan.Param,
  FireDAC.Stan.Error,
  FireDAC.DatS,
  FireDAC.Phys.Intf,
  FireDAC.DApt.Intf,
  FireDAC.Stan.Async,
  FireDAC.DApt,
  FireDAC.Comp.DataSet,
  FireDAC.Comp.Client;

type
  TfraZahteviOdobrenje = class(TFrame)

    pnlHeader: TPanel;
    lblNaslov: TLabel;
    lblOpis: TLabel;

    pnlSadrzaj: TPanel;

    // ========================================================
    // STATISTIKA
    // ========================================================

    pnlStatistika: TPanel;

    pnlCekanje: TPanel;
    lblCekanjeNaslov: TLabel;
    lblCekanjeBroj: TLabel;
    lblCekanjeOpis: TLabel;
    pnlIkonaCekanje: TPanel;
    imgCekanje: TImage;

    pnlOdobreni: TPanel;
    lblOdobreniNaslov: TLabel;
    lblOdobreniBroj: TLabel;
    lblOdobreniOpis: TLabel;
    pnlIkonaOdobreni: TPanel;
    imgOdobreni: TImage;

    pnlHitni: TPanel;
    lblHitniNaslov: TLabel;
    lblHitniBroj: TLabel;
    lblHitniOpis: TLabel;
    pnlIkonaHitni: TPanel;
    imgHitni: TImage;

    // ========================================================
    // TABELA
    // ========================================================

    pnlTabela: TPanel;
    lblTabelaNaslov: TLabel;
    dbgZahtevi: TDBGrid;

    qryZahtevi: TFDQuery;
    dsZahtevi: TDataSource;

    // ========================================================
    // DETALJI
    // ========================================================

    pnlDetalji: TPanel;
    lblDetaljiNaslov: TLabel;
    lblIDZahteva: TLabel;

    lblMaterijalNaslov: TLabel;
    lblMaterijalVrednost: TLabel;

    lblKolicinaNaslov: TLabel;
    lblKolicinaVrednost: TLabel;

    lblPrioritetNaslov: TLabel;
    lblPrioritetVrednost: TLabel;

    lblDatumNaslov: TLabel;
    lblDatumVrednost: TLabel;

    lblRazlogNaslov: TLabel;

    lblPodnosilacNaslov: TLabel;
    lblPodnosilacVrednost: TLabel;

    memRazlog: TMemo;

    btnOdbij: TButton;

    memKomentar: TMemo;
    lblKomentarNaslov: TLabel;

    btnOdobri: TButton;

  private

    // NOVO - učitavanje gornjih statističkih kartica
    procedure UcitajStatistiku;

    // NOVO - učitavanje pending zahteva
    procedure UcitajZahteve;

    // NOVO - podešavanje DBGrid kolona
    procedure PodesiKolone;

    // NOVO - popunjavanje desnog panela
    procedure PrikaziIzabraniZahtev;

    // NOVO - čišćenje desnog panela
    procedure OcistiDetalje;

    // NOVO - promena reda u tabeli
    procedure qryZahteviAfterScroll(DataSet: TDataSet);

    // NOVO - dugmad
    procedure btnOdobriClick(Sender: TObject);
    procedure btnOdbijClick(Sender: TObject);

    // NOVO - zajednička procedura za odluku
    procedure OdluciZahtev(const NoviStatus: string);

  public

    constructor Create(AOwner: TComponent); override;

    // NOVO - može se pozvati kada god želimo
    // da osvežimo celu stranicu
    procedure Osvezi;

  end;

implementation

uses
  uLogin;

{$R *.dfm}


// ============================================================
// KREIRANJE FRAME-A
// ============================================================

constructor TfraZahteviOdobrenje.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);

  // ==========================================================
  // POVEZIVANJE SA BAZOM
  // ==========================================================

  qryZahtevi.Connection :=
    frmLogin.FDConnection1;

  dsZahtevi.DataSet :=
    qryZahtevi;

  dbgZahtevi.DataSource :=
    dsZahtevi;


  // ==========================================================
  // DBGRID
  // ==========================================================

  dbgZahtevi.ReadOnly := True;

  dbgZahtevi.Options :=
    dbgZahtevi.Options + [dgRowSelect];


  // ==========================================================
  // DOGAĐAJI
  // ==========================================================

  qryZahtevi.AfterScroll :=
    qryZahteviAfterScroll;

  btnOdobri.OnClick :=
    btnOdobriClick;

  btnOdbij.OnClick :=
    btnOdbijClick;


  // ==========================================================
  // MEMO
  // ==========================================================

  memRazlog.ReadOnly := True;


  // ==========================================================
  // POČETNO STANJE
  // ==========================================================

  OcistiDetalje;

  Osvezi;
end;


// ============================================================
// OSVEŽAVANJE CELE STRANICE
// ============================================================

procedure TfraZahteviOdobrenje.Osvezi;
begin
  UcitajStatistiku;
  UcitajZahteve;
end;


// ============================================================
// STATISTIKA
// ============================================================

procedure TfraZahteviOdobrenje.UcitajStatistiku;
var
  Q: TFDQuery;
begin

  Q := TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    // ========================================================
    // Jednim SQL upitom računamo sve tri vrednosti
    // ========================================================

    Q.SQL.Text :=
      'SELECT ' +

      'COUNT(CASE ' +
      'WHEN status = ''pending'' ' +
      'THEN 1 END) AS cekanje, ' +

      'COUNT(CASE ' +
      'WHEN status = ''pending'' ' +
      'AND priority = ''Visok'' ' +
      'THEN 1 END) AS hitni, ' +

      'COUNT(CASE ' +
      'WHEN status = ''approved'' ' +
      'THEN 1 END) AS odobreni ' +

      'FROM requests';

    Q.Open;


    // ========================================================
    // NA ČEKANJU
    // ========================================================

    lblCekanjeBroj.Caption :=
      Q.FieldByName('cekanje').AsString;


    // ========================================================
    // HITNI
    // ========================================================

    lblHitniBroj.Caption :=
      Q.FieldByName('hitni').AsString;


    // ========================================================
    // ODOBRENI
    // ========================================================

    lblOdobreniBroj.Caption :=
      Q.FieldByName('odobreni').AsString;


  except

    on E: Exception do
    begin
      ShowMessage(
        'Greška prilikom učitavanja statistike:' +
        sLineBreak +
        E.Message
      );
    end;

  end;

  Q.Free;
end;


// ============================================================
// UČITAVANJE ZAHTEVA KOJI ČEKAJU ODOBRENJE
// ============================================================

procedure TfraZahteviOdobrenje.UcitajZahteve;
begin

  qryZahtevi.Close;

  qryZahtevi.SQL.Text :=

    'SELECT ' +

    // ========================================================
    // INTERNI ID
    // ========================================================

    'r.id, ' +


    // ========================================================
    // ŠIFRA ZAHTEVA
    // Z-2026-0001
    // ========================================================

    '''Z-'' || ' +
    'strftime(''%Y'', r.created_at) || ' +
    '''-'' || ' +
    'printf(''%04d'', r.id) AS sifra, ' +


    // ========================================================
    // PODNOSILAC
    // ========================================================

    'CAST(u.name AS VARCHAR(100)) ' +
    'AS podnosilac, ' +


    // ========================================================
    // MATERIJAL
    // ========================================================

    'CAST(m.name AS VARCHAR(100)) ' +
    'AS materijal, ' +


    // ========================================================
    // KOLIČINA + JEDINICA
    // ========================================================

    'CAST(' +
    'printf(''%g'', r.quantity) || ' +
    ''' '' || m.unit ' +
    'AS VARCHAR(50)) ' +
    'AS kolicina, ' +


    // ========================================================
    // PRIORITET
    // ========================================================

    'CAST(r.priority AS VARCHAR(30)) ' +
    'AS prioritet, ' +


    // ========================================================
    // DATUM POTREBE
    // ========================================================

    'strftime(''%d.%m.%Y'', r.needed_by) ' +
    'AS datum_potrebe, ' +


    // ========================================================
    // DATUM KREIRANJA
    // ========================================================

    'strftime(''%d.%m.%Y'', r.created_at) ' +
    'AS datum_kreiranja, ' +


    // ========================================================
    // OBRAZLOŽENJE
    // ========================================================

    'CAST(r.reason AS VARCHAR(1000)) ' +
    'AS reason, ' +


    // ========================================================
    // KOMENTAR MENADŽERA
    // ========================================================

    'CAST(r.manager_comment AS VARCHAR(1000)) ' +
    'AS manager_comment, ' +


    // ========================================================
    // STATUS
    // ========================================================

    'CAST(r.status AS VARCHAR(30)) ' +
    'AS status_raw ' +


    // ========================================================
    // TABELE
    // ========================================================

    'FROM requests r ' +

    'INNER JOIN materials m ' +
    'ON m.id = r.material_id ' +

    'INNER JOIN users u ' +
    'ON u.id = r.user_id ' +


    // ========================================================
    // SAMO ZAHTEVI KOJI ČEKAJU ODLUKU
    // ========================================================

    'WHERE r.status = ''pending'' ' +


    // ========================================================
    // HITNI PRVO, PA NAJNOVIJI
    // ========================================================

    'ORDER BY ' +

    'CASE r.priority ' +
    'WHEN ''Visok'' THEN 1 ' +
    'WHEN ''Srednji'' THEN 2 ' +
    'WHEN ''Nizak'' THEN 3 ' +
    'ELSE 4 ' +
    'END, ' +

    'r.created_at DESC, ' +
    'r.id DESC';


  try

    qryZahtevi.Open;

    PodesiKolone;

    PrikaziIzabraniZahtev;

  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja zahteva:' +
        sLineBreak +
        E.Message
      );

      OcistiDetalje;

    end;

  end;

end;


// ============================================================
// PODEŠAVANJE KOLONA U TABELI
// ============================================================

procedure TfraZahteviOdobrenje.PodesiKolone;
begin

  dbgZahtevi.Columns.Clear;


  // ==========================================================
  // ID
  // ==========================================================

  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'sifra';
    Title.Caption := 'ID';
    Width := 105;
  end;


  // ==========================================================
  // PODNOSILAC
  // ==========================================================

  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'podnosilac';
    Title.Caption := 'Podnosilac';
    Width := 140;
  end;


  // ==========================================================
  // MATERIJAL
  // ==========================================================

  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'materijal';
    Title.Caption := 'Materijal';
    Width := 150;
  end;


  // ==========================================================
  // KOLIČINA
  // ==========================================================

  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'kolicina';
    Title.Caption := 'Količina';
    Width := 80;
  end;


  // ==========================================================
  // PRIORITET
  // ==========================================================

  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'prioritet';
    Title.Caption := 'Prioritet';
    Width := 80;
  end;


  // ==========================================================
  // DATUM POTREBE
  // ==========================================================

  with dbgZahtevi.Columns.Add do
  begin
    FieldName := 'datum_potrebe';
    Title.Caption := 'Potrebno do';
    Width := 95;
  end;

end;


// ============================================================
// PROMENA IZABRANOG REDA
// ============================================================

procedure TfraZahteviOdobrenje.qryZahteviAfterScroll(
  DataSet: TDataSet
);
begin
  PrikaziIzabraniZahtev;
end;


// ============================================================
// PRIKAZ DETALJA
// ============================================================

procedure TfraZahteviOdobrenje.PrikaziIzabraniZahtev;
begin

  if (not qryZahtevi.Active) or
     qryZahtevi.IsEmpty then
  begin
    OcistiDetalje;
    Exit;
  end;


  // ==========================================================
  // ID
  // ==========================================================

  lblIDZahteva.Caption :=
    qryZahtevi.FieldByName('sifra').AsString;


  // ==========================================================
  // MATERIJAL
  // ==========================================================

  lblMaterijalVrednost.Caption :=
    qryZahtevi.FieldByName('materijal').AsString;


  // ==========================================================
  // KOLIČINA
  // ==========================================================

  lblKolicinaVrednost.Caption :=
    qryZahtevi.FieldByName('kolicina').AsString;


  // ==========================================================
  // PRIORITET
  // ==========================================================

  lblPrioritetVrednost.Caption :=
    qryZahtevi.FieldByName('prioritet').AsString;


  // ==========================================================
  // DATUM POTREBE
  // ==========================================================

  lblDatumVrednost.Caption :=
    qryZahtevi.FieldByName('datum_potrebe').AsString;


  // ==========================================================
  // PODNOSILAC
  // ==========================================================

  lblPodnosilacVrednost.Caption :=
    qryZahtevi.FieldByName('podnosilac').AsString;


  // ==========================================================
  // OBRAZLOŽENJE
  // ==========================================================

  memRazlog.Lines.Text :=
    qryZahtevi.FieldByName('reason').AsString;


  // ==========================================================
  // KOMENTAR
  // ==========================================================

  memKomentar.Lines.Text :=
    qryZahtevi.FieldByName('manager_comment').AsString;


  // Dugmad omogućena jer postoji izabrani pending zahtev
  btnOdobri.Enabled := True;
  btnOdbij.Enabled := True;

end;


// ============================================================
// ČIŠĆENJE DESNOG PANELA
// ============================================================

procedure TfraZahteviOdobrenje.OcistiDetalje;
begin

  lblIDZahteva.Caption := '-';

  lblMaterijalVrednost.Caption := '-';

  lblKolicinaVrednost.Caption := '-';

  lblPrioritetVrednost.Caption := '-';

  lblDatumVrednost.Caption := '-';

  lblPodnosilacVrednost.Caption := '-';

  memRazlog.Clear;

  memKomentar.Clear;

  btnOdobri.Enabled := False;

  btnOdbij.Enabled := False;

end;


// ============================================================
// ODOBRI
// ============================================================

procedure TfraZahteviOdobrenje.btnOdobriClick(Sender: TObject);
begin
  OdluciZahtev('approved');
end;


// ============================================================
// ODBIJ
// ============================================================

procedure TfraZahteviOdobrenje.btnOdbijClick(Sender: TObject);
begin

  // Kod odbijanja zahtevamo komentar
  if Trim(memKomentar.Text) = '' then
  begin

    ShowMessage(
      'Unesite razlog odbijanja zahteva.'
    );

    memKomentar.SetFocus;

    Exit;

  end;


  OdluciZahtev('rejected');
end;


// ============================================================
// ODLUKA MENADŽERA
// ============================================================

procedure TfraZahteviOdobrenje.OdluciZahtev(
  const NoviStatus: string
);
var
  Q: TFDQuery;

  ZahtevID: Integer;
  SifraZahteva: string;

  Poruka: string;
begin

  // ==========================================================
  // PROVERA
  // ==========================================================

  if (not qryZahtevi.Active) or
     qryZahtevi.IsEmpty then
  begin
    ShowMessage(
      'Nije izabran zahtev.'
    );
    Exit;
  end;


  ZahtevID :=
    qryZahtevi.FieldByName('id').AsInteger;

  SifraZahteva :=
    qryZahtevi.FieldByName('sifra').AsString;


  // ==========================================================
  // PORUKA ZA POTVRDU
  // ==========================================================

  if SameText(NoviStatus, 'approved') then
  begin

    Poruka :=
      'Da li ste sigurni da želite da odobrite zahtev ' +
      SifraZahteva +
      '?';

  end
  else
  begin

    Poruka :=
      'Da li ste sigurni da želite da odbijete zahtev ' +
      SifraZahteva +
      '?';

  end;


  if MessageDlg(
    Poruka,
    mtConfirmation,
    [mbYes, mbNo],
    0
  ) <> mrYes then
    Exit;


  // ==========================================================
  // UPDATE
  // ==========================================================

  Q := TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=
      'UPDATE requests ' +
      'SET status = :status, ' +
      '    manager_comment = :manager_comment ' +
      'WHERE id = :id ' +
      'AND status = ''pending''';


    Q.ParamByName('status').AsString :=
      NoviStatus;

    Q.ParamByName('manager_comment').AsString :=
      Trim(memKomentar.Text);

    Q.ParamByName('id').AsInteger :=
      ZahtevID;


    try

      Q.ExecSQL;


      // ======================================================
      // PROVERA DA LI JE UPDATE USPEO
      // ======================================================

      if Q.RowsAffected = 0 then
      begin

        ShowMessage(
          'Zahtev više ne čeka odobrenje.' +
          sLineBreak +
          'Lista će biti osvežena.'
        );

        Osvezi;

        Exit;

      end;


      // ======================================================
      // USPEŠNA ODLUKA
      // ======================================================

      if SameText(NoviStatus, 'approved') then
      begin

        ShowMessage(
          'Zahtev ' +
          SifraZahteva +
          ' je uspešno odobren.'
        );

      end
      else
      begin

        ShowMessage(
          'Zahtev ' +
          SifraZahteva +
          ' je odbijen.'
        );

      end;


      // ======================================================
      // OSVEŽAVANJE CELOG EKRANA
      // ======================================================

      Osvezi;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom obrade zahteva:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;

end.
