unit uNoviZahtev;

interface

uses
  Winapi.Windows,
  Winapi.Messages,
  System.SysUtils,
  System.Variants,
  System.Classes,
  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.ExtCtrls,
  Vcl.StdCtrls,

  FireDAC.Stan.Intf,
  FireDAC.Stan.Option,
  FireDAC.Stan.Param,
  FireDAC.Stan.Error,
  FireDAC.DatS,
  FireDAC.Phys.Intf,
  FireDAC.DApt.Intf,
  FireDAC.Stan.Async,
  FireDAC.DApt,
  Data.DB,
  FireDAC.Comp.DataSet,
  FireDAC.Comp.Client, Vcl.ComCtrls;

type
  TfraNoviZahtev = class(TFrame)
    pnlHeader: TPanel;
    Label1: TLabel;
    lblOpis: TLabel;
    pnlSadrzaj: TPanel;
    pnlSaveti: TPanel;
    pnlForma: TPanel;
    lblDetaljiZahteva: TLabel;
    Label2: TLabel;
    lblKategorija: TLabel;
    lblMaterijal: TLabel;
    cmbKategorija: TComboBox;
    cmbMaterijal: TComboBox;
    qryMaterijali: TFDQuery;
    lblKolicina: TLabel;
    edtKolicina: TEdit;
    lblJedinicaMere: TLabel;
    edtJedinicaMere: TEdit;
    lblPrioritet: TLabel;
    cmbPrioritet: TComboBox;
    dtpDatumPotrebe: TDateTimePicker;
    lblDatumPotrebe: TLabel;
    lblRazlog: TLabel;
    memRazlog: TMemo;
    btnPosaljiZahtev: TButton;

  private
    // NOVO - učitavanje kategorija iz baze
    procedure UcitajKategorije;

    // NOVO - učitavanje materijala za izabranu kategoriju
    procedure UcitajMaterijale;

    // NOVO - reaguje kada korisnik promeni kategoriju
    procedure cmbKategorijaChange(Sender: TObject);

  public
    // NOVO - konstruktor frame-a
    constructor Create(AOwner: TComponent); override;
  end;

implementation

uses
  uLogin; // NOVO - zbog FDConnection1 sa login forme

{$R *.dfm}


// ============================================================
// KREIRANJE FRAME-A
// ============================================================

constructor TfraNoviZahtev.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);

  // NOVO - povezujemo query sa konekcijom baze
  qryMaterijali.Connection := frmLogin.FDConnection1;

  // NOVO - korisnik može samo da bira iz liste
  cmbKategorija.Style := csDropDownList;
  cmbMaterijal.Style := csDropDownList;

  // NOVO - materijal nije dostupan dok se ne izabere kategorija
  cmbMaterijal.Enabled := False;

  // NOVO - povezujemo događaj promene kategorije
  cmbKategorija.OnChange := cmbKategorijaChange;

  // NOVO - učitavanje kategorija iz baze
  UcitajKategorije;
end;


// ============================================================
// UČITAVANJE KATEGORIJA
// ============================================================

procedure TfraNoviZahtev.UcitajKategorije;
begin
  cmbKategorija.Clear;

  qryMaterijali.Close;

  qryMaterijali.SQL.Text :=
    'SELECT DISTINCT type ' +
    'FROM materials ' +
    'WHERE type IS NOT NULL ' +
    'AND TRIM(type) <> '''' ' +
    'ORDER BY type';

  qryMaterijali.Open;

  while not qryMaterijali.Eof do
  begin
    cmbKategorija.Items.Add(
      qryMaterijali.FieldByName('type').AsString
    );

    qryMaterijali.Next;
  end;

  qryMaterijali.Close;

  // Ništa nije automatski izabrano
  cmbKategorija.ItemIndex := -1;
end;


// ============================================================
// PROMENA KATEGORIJE
// ============================================================

procedure TfraNoviZahtev.cmbKategorijaChange(Sender: TObject);
begin
  // NOVO - kada korisnik izabere kategoriju,
  // učitaj samo materijale te kategorije
  UcitajMaterijale;
end;


// ============================================================
// UČITAVANJE MATERIJALA
// ============================================================

procedure TfraNoviZahtev.UcitajMaterijale;
var
  MaterijalID: Integer;
begin
  // Brišemo prethodnu listu materijala
  cmbMaterijal.Clear;
  cmbMaterijal.Enabled := False;

  // Ako kategorija nije izabrana, ne radimo ništa
  if cmbKategorija.ItemIndex = -1 then
    Exit;

  qryMaterijali.Close;

  qryMaterijali.SQL.Text :=
    'SELECT id, name ' +
    'FROM materials ' +
    'WHERE type = :type ' +
    'ORDER BY name';

  qryMaterijali.ParamByName('type').AsString :=
    cmbKategorija.Text;

  qryMaterijali.Open;

  while not qryMaterijali.Eof do
  begin
    MaterijalID :=
      qryMaterijali.FieldByName('id').AsInteger;

    // Prikazujemo naziv materijala,
    // a u pozadini čuvamo njegov ID
    cmbMaterijal.Items.AddObject(
      qryMaterijali.FieldByName('name').AsString,
      TObject(NativeInt(MaterijalID))
    );

    qryMaterijali.Next;
  end;

  qryMaterijali.Close;

  // Ako postoje materijali, omogućavamo ComboBox
  if cmbMaterijal.Items.Count > 0 then
    cmbMaterijal.Enabled := True;

  // Ništa nije automatski izabrano
  cmbMaterijal.ItemIndex := -1;
end;

end.
