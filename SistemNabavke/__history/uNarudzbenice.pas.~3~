  DataSet: TDataSet
);
begin

  PrikaziDetaljeNarudzbenice;

end;


// ============================================================
// PRIKAZ DETALJA NARUDŽBENICE
// ============================================================

procedure TfraNarudzbenice.PrikaziDetaljeNarudzbenice;
var
  StatusPrikaz: string;
begin

  if (not FQryNarudzbenice.Active) or
     FQryNarudzbenice.IsEmpty then
  begin

    OcistiDetaljeNarudzbenice;

    Exit;

  end;


  FIzabranaNarudzbenicaID :=
    FQryNarudzbenice.FieldByName(
      'id'
    ).AsInteger;


  // ==========================================================
  // ID
  // ==========================================================

  lblIDVrednost.Caption :=
    FQryNarudzbenice.FieldByName(
      'sifra_narudzbenice'
    ).AsString;


  // ==========================================================
  // ZAHTEV
  // ==========================================================

  lblZahtevDetaljiVrednost.Caption :=
    FQryNarudzbenice.FieldByName(
      'sifra_zahteva'
    ).AsString;


  // ==========================================================
  // MATERIJAL
  // ==========================================================

  lblMaterijalDetaljiVrednost.Caption :=
    FQryNarudzbenice.FieldByName(
      'materijal'
    ).AsString;


  // ==========================================================
  // DOBAVLJAČ
  // ==========================================================

  lblDobavljacDetaljiVrednost.Caption :=
    FQryNarudzbenice.FieldByName(
      'dobavljac'
    ).AsString;


  // ==========================================================
  // KOLIČINA
  // ==========================================================

  lblKolicinaDetaljiVrednost.Caption :=
    FQryNarudzbenice.FieldByName(
      'kolicina_prikaz'
    ).AsString;


  // ==========================================================
  // UKUPNO
  // ==========================================================

  lblUkupnoDetaljiVrednost.Caption :=

    FormatFloat(
      '#,##0.00',
      FQryNarudzbenice.FieldByName(
        'total_price'
      ).AsFloat
    ) +

    ' RSD';


  // ==========================================================
  // DATUM
  // ==========================================================

  lblDatumDetaljiVrednost.Caption :=
    FQryNarudzbenice.FieldByName(
      'datum_prikaz'
    ).AsString;


  // ==========================================================
  // STATUS
  // ==========================================================

  StatusPrikaz :=
    FQryNarudzbenice.FieldByName(
      'status_prikaz'
    ).AsString;


  cmbStatus.ItemIndex :=
    cmbStatus.Items.IndexOf(
      StatusPrikaz
    );


  btnPromeniStatus.Enabled :=
    True;

  btnObrisiPonudu.Enabled :=
    True;

  btnIzaberiPonudu.Enabled :=
    True;

end;


// ============================================================
// ČIŠĆENJE DETALJA NARUDŽBENICE
// ============================================================

procedure TfraNarudzbenice.OcistiDetaljeNarudzbenice;
begin

  FIzabranaNarudzbenicaID :=
    0;


  lblIDVrednost.Caption :=
    '-';

  lblZahtevDetaljiVrednost.Caption :=
    '-';

  lblMaterijalDetaljiVrednost.Caption :=
    '-';

  lblDobavljacDetaljiVrednost.Caption :=
    '-';

  lblKolicinaDetaljiVrednost.Caption :=
    '-';

  lblUkupnoDetaljiVrednost.Caption :=
    '-';

  lblDatumDetaljiVrednost.Caption :=
    '-';


  cmbStatus.ItemIndex :=
    -1;


  btnPromeniStatus.Enabled :=
    False;

  btnObrisiPonudu.Enabled :=
    False;

  btnIzaberiPonudu.Enabled :=
    False;

end;


// ============================================================
// STATUSI
// ============================================================

procedure TfraNarudzbenice.UcitajStatuse;
begin

  cmbStatus.Items.Clear;


  cmbStatus.Items.Add(
    'Kreirana'
  );

  cmbStatus.Items.Add(
    'Poslata'
  );

  cmbStatus.Items.Add(
    'Potvrđena'
  );

  cmbStatus.Items.Add(
    'U toku'
  );

  cmbStatus.Items.Add(
    'Isporučena'
  );

  cmbStatus.Items.Add(
    'Završena'
  );


  cmbStatus.ItemIndex :=
    -1;

end;


// ============================================================
// DB STATUS -> PRIKAZ
// ============================================================

function TfraNarudzbenice.StatusDBUPrikaz(
  const AStatus: string
): string;
begin

  if SameText(
    AStatus,
    'created'
  ) then
    Result := 'Kreirana'

  else if SameText(
    AStatus,
    'sent'
  ) then
    Result := 'Poslata'

  else if SameText(
    AStatus,
    'confirmed'
  ) then
    Result := 'Potvrđena'

  else if SameText(
    AStatus,
    'in_progress'
  ) then
    Result := 'U toku'

  else if SameText(
    AStatus,
    'delivered'
  ) then
    Result := 'Isporučena'

  else if SameText(
    AStatus,
    'completed'
  ) then
    Result := 'Završena'

  else
    Result := AStatus;

end;


// ============================================================
// PRIKAZ -> DB STATUS
// ============================================================

function TfraNarudzbenice.StatusPrikazUDB(
  const AStatus: string
): string;
begin

  if SameText(
    AStatus,
    'Kreirana'
  ) then
    Result := 'created'

  else if SameText(
    AStatus,
    'Poslata'
  ) then
    Result := 'sent'

  else if SameText(
    AStatus,
    'Potvrđena'
  ) then
    Result := 'confirmed'

  else if SameText(
    AStatus,
    'U toku'
  ) then
    Result := 'in_progress'

  else if SameText(
    AStatus,
    'Isporučena'
  ) then
    Result := 'delivered'

  else if SameText(
    AStatus,
    'Završena'
  ) then
    Result := 'completed'

  else
    Result := '';

end;


// ============================================================
// PROMENI STATUS
// ============================================================

procedure TfraNarudzbenice.btnPromeniStatusClick(
  Sender: TObject
);
var
  Q: TFDQuery;
  NoviStatus: string;
begin

  if FIzabranaNarudzbenicaID = 0 then
  begin

    ShowMessage(
      'Izaberite narudžbenicu.'
    );

    Exit;

  end;


  if cmbStatus.ItemIndex < 0 then
  begin

    ShowMessage(
      'Izaberite status.'
    );

    Exit;

  end;


  NoviStatus :=
    StatusPrikazUDB(
      cmbStatus.Text
    );


  if NoviStatus = '' then
  begin

    ShowMessage(
      'Status nije validan.'
    );

    Exit;

  end;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'UPDATE orders ' +

      'SET status = :status ' +

      'WHERE id = :id';


    Q.ParamByName(
      'status'
    ).AsString :=
      NoviStatus;


    Q.ParamByName(
      'id'
    ).AsInteger :=
      FIzabranaNarudzbenicaID;


    try

      Q.ExecSQL;


      ShowMessage(
        'Status narudžbenice je uspešno promenjen.'
      );


      UcitajNarudzbenice;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom promene statusa:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// OBRIŠI NARUDŽBENICU
// ============================================================

procedure TfraNarudzbenice.btnObrisiPonuduClick(
  Sender: TObject
);
var
  Q: TFDQuery;

  Status: string;
begin

  if FIzabranaNarudzbenicaID = 0 then
  begin

    ShowMessage(
      'Izaberite narudžbenicu.'
    );

    Exit;

  end;


  Status :=
    FQryNarudzbenice.FieldByName(
      'status'
    ).AsString;


  // ==========================================================
  // ČUVAMO ISTORIJU
  // ==========================================================

  if not SameText(
    Status,
    'created'
  ) then
  begin

    ShowMessage(
      'Moguće je obrisati samo narudžbenicu koja još nije poslata.'
    );

    Exit;

  end;


  if MessageDlg(

    'Da li ste sigurni da želite da obrišete narudžbenicu ' +
    lblIDVrednost.Caption +
    '?',

    mtConfirmation,
    [mbYes, mbNo],
    0

  ) <> mrYes then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    // ========================================================
    // DA LI POSTOJI PRIJEM ROBE?
    // ========================================================

    Q.SQL.Text :=

      'SELECT COUNT(*) AS broj ' +

      'FROM deliveries ' +

      'WHERE order_id = :order_id';


    Q.ParamByName(
      'order_id'
    ).AsInteger :=
      FIzabranaNarudzbenicaID;


    Q.Open;


    if Q.FieldByName(
      'broj'
    ).AsInteger > 0 then
    begin

      ShowMessage(
        'Narudžbenicu nije moguće obrisati jer postoji prijem robe.'
      );

      Exit;

    end;


    // ========================================================
    // DELETE
    // ========================================================

    Q.Close;


    Q.SQL.Text :=

      'DELETE FROM orders ' +

      'WHERE id = :id ' +
      'AND status = ''created''';


    Q.ParamByName(
      'id'
    ).AsInteger :=
      FIzabranaNarudzbenicaID;


    Q.ExecSQL;


    ShowMessage(
      'Narudžbenica je obrisana.'
    );


    // Zahtev ponovo postaje dostupan
    UcitajZahteveZaKreiranje;

    UcitajNarudzbenice;


  finally

    Q.Free;

  end;

end;


// ============================================================
// PRIKAŽI DETALJE
// ============================================================

procedure TfraNarudzbenice.btnIzaberiPonuduClick(
  Sender: TObject
);
begin

  if (not FQryNarudzbenice.Active) or
     FQryNarudzbenice.IsEmpty then
  begin

    ShowMessage(
      'Nema narudžbenice za prikaz.'
    );

    Exit;

  end;


  PrikaziDetaljeNarudzbenice;

end;


