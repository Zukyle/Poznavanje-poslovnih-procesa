// ============================================================
// UČITAVANJE ZAHTEVA KOJI SU SPREMNI ZA NARUDŽBENICU
// ============================================================

procedure TfraNarudzbenice.UcitajZahteveZaKreiranje;
var
  Q: TFDQuery;
begin

  cmbZahtev.Items.Clear;
  cmbZahtev.ItemIndex := -1;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    // --------------------------------------------------------
    // Prikazujemo samo zahteve:
    //
    // 1. koji su odobreni
    // 2. imaju izabranu ponudu
    // 3. još nemaju narudžbenicu
    // --------------------------------------------------------

    Q.SQL.Text :=

      'SELECT DISTINCT ' +

      'r.id, ' +

      'CAST(' +
        '''Z-'' || ' +
        'strftime(''%Y'', r.created_at) || ' +
        '''-'' || printf(''%04d'', r.id) ' +
      'AS VARCHAR(30)) AS sifra, ' +

      'CAST(m.name AS VARCHAR(150)) AS materijal ' +

      'FROM requests r ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'INNER JOIN offers ofr ' +
      'ON ofr.request_id = r.id ' +
      'AND ofr.selected = 1 ' +

      'WHERE r.status = ''approved'' ' +

      'AND NOT EXISTS (' +

        'SELECT 1 ' +
        'FROM orders ord ' +
        'WHERE ord.request_id = r.id' +

      ') ' +

      'ORDER BY r.needed_by ASC';


    Q.Open;


    while not Q.Eof do
    begin

      cmbZahtev.Items.AddObject(

        Q.FieldByName(
          'sifra'
        ).AsString +

        ' - ' +

        Q.FieldByName(
          'materijal'
        ).AsString,

        TObject(
          NativeInt(
            Q.FieldByName(
              'id'
            ).AsInteger
          )
        )

      );


      Q.Next;

    end;


  finally

    Q.Free;

  end;


  // ==========================================================
  // BIRAMO PRVI ZAHTEV
  // ==========================================================

  if cmbZahtev.Items.Count > 0 then
  begin

    cmbZahtev.ItemIndex :=
      0;

    cmbZahtevChange(
      cmbZahtev
    );

  end
  else
  begin

    OcistiDetaljePonude;

    btnKreirajNarudzbenicu.Enabled :=
      False;

  end;

end;


// ============================================================
// PROMENA ZAHTEVA
// ============================================================

procedure TfraNarudzbenice.cmbZahtevChange(
  Sender: TObject
);
begin

  if cmbZahtev.ItemIndex < 0 then
  begin

    OcistiDetaljePonude;

    btnKreirajNarudzbenicu.Enabled :=
      False;

    Exit;

  end;


  FZahtevID :=
    Integer(
      NativeInt(
        cmbZahtev.Items.Objects[
          cmbZahtev.ItemIndex
        ]
      )
    );


  UcitajDetaljePonude;

end;


// ============================================================
// UČITAVANJE IZABRANE PONUDE
// ============================================================

procedure TfraNarudzbenice.UcitajDetaljePonude;
var
  Q: TFDQuery;

  Materijal: string;
  Jedinica: string;
  Dobavljac: string;

  Kolicina: Double;
  Cena: Double;
begin

  OcistiDetaljePonude;


  if FZahtevID = 0 then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT ' +

      'ofr.id AS offer_id, ' +

      's.id AS supplier_id, ' +

      'CAST(m.name AS VARCHAR(150)) AS materijal, ' +

      'r.quantity, ' +

      'CAST(m.unit AS VARCHAR(50)) AS jedinica, ' +

      'CAST(s.name AS VARCHAR(150)) AS dobavljac, ' +

      'ofr.unit_price, ' +

      'ofr.delivery_days, ' +

      '(r.quantity * ofr.unit_price) AS ukupna_cena ' +

      'FROM requests r ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'INNER JOIN offers ofr ' +
      'ON ofr.request_id = r.id ' +
      'AND ofr.selected = 1 ' +

      'INNER JOIN suppliers s ' +
      'ON s.id = ofr.supplier_id ' +

      'WHERE r.id = :request_id ' +
      'AND r.status = ''approved'' ' +

      'LIMIT 1';


    Q.ParamByName(
      'request_id'
    ).AsInteger :=
      FZahtevID;


    Q.Open;


    if Q.IsEmpty then
    begin

      ShowMessage(
        'Za izabrani zahtev ne postoji izabrana ponuda.'
      );

      btnKreirajNarudzbenicu.Enabled :=
        False;

      Exit;

    end;


    // ========================================================
    // ČUVAMO ID-EVE I VREDNOSTI
    // ========================================================

    FOfferID :=
      Q.FieldByName(
        'offer_id'
      ).AsInteger;


    FDobavljacID :=
      Q.FieldByName(
        'supplier_id'
      ).AsInteger;


    FRokIsporuke :=
      Q.FieldByName(
        'delivery_days'
      ).AsInteger;


    FUkupnaCena :=
      Q.FieldByName(
        'ukupna_cena'
      ).AsFloat;


    // ========================================================
    // PODACI ZA PRIKAZ
    // ========================================================

    Materijal :=
      Q.FieldByName(
        'materijal'
      ).AsString;


    Kolicina :=
      Q.FieldByName(
        'quantity'
      ).AsFloat;


    Jedinica :=
      Q.FieldByName(
        'jedinica'
      ).AsString;


    Dobavljac :=
      Q.FieldByName(
        'dobavljac'
      ).AsString;


    Cena :=
      Q.FieldByName(
        'unit_price'
      ).AsFloat;


    // ========================================================
    // VALUE LIST EDITOR
    // ========================================================

    vleDetaljiPonude.Strings.Clear;


    vleDetaljiPonude.InsertRow(
      'Materijal',
      Materijal,
      True
    );


    vleDetaljiPonude.InsertRow(
      'Količina',

      FormatFloat(
        '0.##',
        Kolicina
      ) +
      ' ' +
      Jedinica,

      True
    );


    vleDetaljiPonude.InsertRow(
      'Dobavljač',
      Dobavljac,
      True
    );


    vleDetaljiPonude.InsertRow(
      'Cena po jedinici',

      FormatFloat(
        '#,##0.00',
        Cena
      ) +
      ' RSD',

      True
    );


    vleDetaljiPonude.InsertRow(
      'Ukupna cena',

      FormatFloat(
        '#,##0.00',
        FUkupnaCena
      ) +
      ' RSD',

      True
    );


    vleDetaljiPonude.InsertRow(
      'Rok isporuke',

      IntToStr(
        FRokIsporuke
      ) +
      ' dana',

      True
    );


    // ========================================================
    // SADA MOŽEMO DA KREIRAMO NARUDŽBENICU
    // ========================================================

    btnKreirajNarudzbenicu.Enabled :=
      True;


  finally

    Q.Free;

  end;

end;


// ============================================================
// ČIŠĆENJE DETALJA PONUDE
// ============================================================

procedure TfraNarudzbenice.OcistiDetaljePonude;
begin

  FOfferID := 0;
  FDobavljacID := 0;

  FRokIsporuke := 0;
  FUkupnaCena := 0;


  vleDetaljiPonude.Strings.Clear;


  // Ostavimo strukturu vidljivu
  vleDetaljiPonude.InsertRow(
    'Materijal',
    '-',
    True
  );

  vleDetaljiPonude.InsertRow(
    'Količina',
    '-',
    True
  );

  vleDetaljiPonude.InsertRow(
    'Dobavljač',
    '-',
    True
  );

  vleDetaljiPonude.InsertRow(
    'Cena po jedinici',
    '-',
    True
  );

  vleDetaljiPonude.InsertRow(
    'Ukupna cena',
    '-',
    True
  );

  vleDetaljiPonude.InsertRow(
