    '-',
    True
  );

end;


// ============================================================
// KREIRAJ NARUDŽBENICU
// ============================================================

procedure TfraNarudzbenice.btnKreirajNarudzbenicuClick(
  Sender: TObject
);
var
  Q: TFDQuery;

  OcekivaniDatum: TDateTime;
begin

  if FZahtevID = 0 then
  begin

    ShowMessage(
      'Izaberite zahtev.'
    );

    Exit;

  end;


  if FOfferID = 0 then
  begin

    ShowMessage(
      'Za zahtev nije izabrana ponuda.'
    );

    Exit;

  end;


  if FDobavljacID = 0 then
  begin

    ShowMessage(
      'Dobavljač nije pronađen.'
    );

    Exit;

  end;


  // ==========================================================
  // OČEKIVANI DATUM
  // ==========================================================

  OcekivaniDatum :=
    IncDay(
      Date,
      FRokIsporuke
    );


  if MessageDlg(

    'Da li želite da kreirate narudžbenicu?' +
    sLineBreak +
    sLineBreak +

    'Ukupna cena: ' +
    FormatFloat(
      '#,##0.00',
      FUkupnaCena
    ) +
    ' RSD' +
    sLineBreak +

    'Očekivana isporuka: ' +
    FormatDateTime(
      'dd.mm.yyyy',
      OcekivaniDatum
    ),

    mtConfirmation,
    [mbYes, mbNo],
    0

  ) <> mrYes then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'INSERT INTO orders ' +

      '(' +
        'request_id, ' +
        'offer_id, ' +
        'supplier_id, ' +
        'total_price, ' +
        'status, ' +
        'expected_date' +
      ') ' +

      'VALUES ' +

      '(' +
        ':request_id, ' +
        ':offer_id, ' +
        ':supplier_id, ' +
        ':total_price, ' +
        '''created'', ' +
        ':expected_date' +
      ')';


    Q.ParamByName(
      'request_id'
    ).AsInteger :=
      FZahtevID;


    Q.ParamByName(
      'offer_id'
    ).AsInteger :=
      FOfferID;


    Q.ParamByName(
      'supplier_id'
    ).AsInteger :=
      FDobavljacID;


    Q.ParamByName(
      'total_price'
    ).AsFloat :=
      FUkupnaCena;


    Q.ParamByName(
      'expected_date'
    ).AsString :=
      FormatDateTime(
        'yyyy-mm-dd',
        OcekivaniDatum
      );


    try

      Q.ExecSQL;


      ShowMessage(
        'Narudžbenica je uspešno kreirana.'
      );


      // Zahtev sada nestaje iz ComboBox-a
      UcitajZahteveZaKreiranje;


      // Nova narudžbenica se pojavljuje u tabeli
      UcitajNarudzbenice;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom kreiranja narudžbenice:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// UČITAVANJE NARUDŽBENICA
// ============================================================

procedure TfraNarudzbenice.UcitajNarudzbenice;
begin

  FQryNarudzbenice.Close;


  FQryNarudzbenice.SQL.Text :=

    'SELECT ' +

    'ord.id, ' +

    'CAST(' +
      '''N-'' || printf(''%04d'', ord.id) ' +
    'AS VARCHAR(30)) ' +
    'AS sifra_narudzbenice, ' +

    'CAST(' +
      '''Z-'' || ' +
      'strftime(''%Y'', r.created_at) || ' +
      '''-'' || printf(''%04d'', r.id) ' +
    'AS VARCHAR(30)) ' +
    'AS sifra_zahteva, ' +

    'CAST(m.name AS VARCHAR(150)) ' +
    'AS materijal, ' +

    'CAST(s.name AS VARCHAR(150)) ' +
    'AS dobavljac, ' +

    'CAST(' +
      'printf(''%g'', r.quantity) || ' +
      ''' '' || m.unit ' +
    'AS VARCHAR(50)) ' +
    'AS kolicina_prikaz, ' +

    'ord.total_price, ' +

    'CAST(' +
      'printf(''%.2f'', ord.total_price) ' +
    'AS VARCHAR(50)) ' +
    'AS ukupno_prikaz, ' +

    'CAST(ord.status AS VARCHAR(30)) ' +
    'AS status, ' +

    'CAST(' +

      'CASE ord.status ' +

        'WHEN ''created'' THEN ''Kreirana'' ' +
        'WHEN ''sent'' THEN ''Poslata'' ' +
        'WHEN ''confirmed'' THEN ''Potvrđena'' ' +
        'WHEN ''in_progress'' THEN ''U toku'' ' +
        'WHEN ''delivered'' THEN ''Isporučena'' ' +
        'WHEN ''completed'' THEN ''Završena'' ' +

        'ELSE ord.status ' +

      'END ' +

    'AS VARCHAR(50)) ' +
    'AS status_prikaz, ' +

    'CAST(' +

      'CASE ' +

        'WHEN ord.expected_date IS NULL THEN '''' ' +

        'ELSE strftime(''%d.%m.%Y'', ord.expected_date) ' +

      'END ' +

    'AS VARCHAR(30)) ' +
    'AS datum_prikaz ' +

    'FROM orders ord ' +

    'INNER JOIN requests r ' +
    'ON r.id = ord.request_id ' +

    'INNER JOIN materials m ' +
    'ON m.id = r.material_id ' +

    'INNER JOIN suppliers s ' +
    'ON s.id = ord.supplier_id ' +

    'ORDER BY ord.created_at DESC, ord.id DESC';


  try

    FQryNarudzbenice.Open;


    PodesiKolone;


    if not FQryNarudzbenice.IsEmpty then
    begin

      FQryNarudzbenice.First;

      PrikaziDetaljeNarudzbenice;

    end
    else
    begin

      OcistiDetaljeNarudzbenice;

    end;


  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja narudžbenica:' +
        sLineBreak +
        E.Message
      );

      OcistiDetaljeNarudzbenice;

    end;

  end;

end;


