procedure TfrmGlavna.OtvoriPonudeZaZahtev(
  AZahtevID: Integer
);
begin

  SakrijSveFrameove;


  // Ako frame Ponude još nije napravljen
  if not Assigned(FFraPonude) then
  begin

    FFraPonude :=
      TfraPonude.Create(Self);

    FFraPonude.Parent :=
      pnlSadrzaj;

    FFraPonude.Align :=
      alClient;

  end;


  // Prikazujemo frame
  FFraPonude.Visible :=
    True;

  FFraPonude.BringToFront;


  // NOVO
  // Automatski biramo zahtev sa kog smo došli
  TfraPonude(
    FFraPonude
  ).OtvoriZaZahtev(
    AZahtevID
  );

end;

