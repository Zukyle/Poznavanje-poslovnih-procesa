// ======================================================
// SAKRIVANJE SVIH FRAME-OVA
// ======================================================

procedure TfrmGlavna.SakrijSveFrameove;
var
  I: Integer;
begin

  for I := 0 to pnlSadrzaj.ControlCount - 1 do
  begin

    if pnlSadrzaj.Controls[I] is TFrame then
      pnlSadrzaj.Controls[I].Visible := False;

  end;

end;


// ======================================================
// SAKRIVANJE SVIH OPCIJA
// ======================================================

procedure TfrmGlavna.SakrijSveOpcije;
begin

  btnDashboard.Visible := False;

  // PODNOSILAC
  btnNoviZahtev.Visible := False;
  btnMojiZahtevi.Visible := False;
  btnAktivneNabavke.Visible := False;

  // MENADZER
  btnZahteviOdobrenje.Visible := False;
  btnSviZahtevi.Visible := False;

  // NABAVKA
  btnOdobreniZahtevi.Visible := False;
  btnDobavljaci.Visible := False;
  btnPonude.Visible := False;
  btnNarudzbenice.Visible := False;

  // MAGACIONER
  btnOcekivaneIsporuke.Visible := False;
  btnPrijemRobe.Visible := False;
  btnMagacin.Visible := False;

  // ADMINISTRATOR
  btnKorisnici.Visible := False;
  btnMaterijali.Visible := False;
  btnOsnovniPodaci.Visible := False;

end;


// ======================================================
// PRAVA PRISTUPA
// ======================================================

procedure TfrmGlavna.PrimeniPravaPristupa;
begin

  SakrijSveOpcije;


  // Dashboard vidi svako
  btnDashboard.Visible := True;


  // ====================================================
  // PODNOSILAC
  // ====================================================

  if SameText(FUloga, 'Podnosilac') then
  begin

    btnNoviZahtev.Visible := True;
    btnMojiZahtevi.Visible := True;
    btnAktivneNabavke.Visible := True;

  end


  // ====================================================
  // MENADZER
  // ====================================================

  else if SameText(FUloga, 'Menadzer') then
  begin

    btnZahteviOdobrenje.Visible := True;
    btnSviZahtevi.Visible := True;
    btnAktivneNabavke.Visible := True;

  end


  // ====================================================
  // SLUZBA NABAVKE
  // ====================================================

  else if SameText(FUloga, 'Nabavka') then
  begin

    btnOdobreniZahtevi.Visible := True;
    btnDobavljaci.Visible := True;
    btnPonude.Visible := True;
    btnNarudzbenice.Visible := True;

  end


  // ====================================================
  // MAGACIONER
  // ====================================================

  else if SameText(FUloga, 'Magacioner') then
  begin

    btnOcekivaneIsporuke.Visible := True;
    btnPrijemRobe.Visible := True;
    btnMagacin.Visible := True;

  end


  // ====================================================
  // ADMINISTRATOR
  // ====================================================

  else if SameText(FUloga, 'Administrator') then
  begin

    btnKorisnici.Visible := True;
    btnMaterijali.Visible := True;
    btnOsnovniPodaci.Visible := True;

  end


  // ====================================================
  // NEPOZNATA ULOGA
  // ====================================================

  else
  begin

    ShowMessage(
      'Nepoznata korisnička uloga: ' +
      FUloga
    );

  end;

end;


// ======================================================
// PRIJAVA KORISNIKA
// ======================================================

procedure TfrmGlavna.PrijaviKorisnika(
  AKorisnikID: Integer;
  const AKorisnickoIme: string;
  const AImeKorisnika: string;
  const AUloga: string
);
begin

  FKorisnikID :=
    AKorisnikID;

  FKorisnickoIme :=
    AKorisnickoIme;

  FImeKorisnika :=
    AImeKorisnika;

  FUloga :=
    AUloga;


  // Sakrivamo ekran prethodnog korisnika
  SakrijSveFrameove;


  // Prava pristupa
  PrimeniPravaPristupa;


  // ====================================================
  // POVEZIVANJE NAVIGACIJE
  // ====================================================

  btnNoviZahtev.OnClick :=
    btnNoviZahtevClick;

  btnMojiZahtevi.OnClick :=
    btnMojiZahteviClick;

  btnZahteviOdobrenje.OnClick :=
    btnZahteviOdobrenjeClick;

  btnSviZahtevi.OnClick :=
    btnSviZahteviClick;

  btnOdobreniZahtevi.OnClick :=
    btnOdobreniZahteviClick;

  btnDobavljaci.OnClick :=
    btnDobavljaciClick;

  // NOVO
  btnPonude.OnClick :=
    btnPonudeClick;

  btnNarudzbenice.OnClick :=
    btnNarudzbeniceClick;

  btnAktivneNabavke.OnClick :=
    btnAktivneNabavkeClick;

  btnOcekivaneIsporuke.OnClick :=
    btnOcekivaneIsporukeClick;

  btnPrijemRobe.OnClick :=
    btnPrijemRobeClick;

  btnMagacin.OnClick :=
    btnMagacinClick;

  btnKorisnici.OnClick :=
    btnKorisniciClick;

  btnMaterijali.OnClick :=
    btnMaterijaliClick;

  btnOsnovniPodaci.OnClick :=
    btnOsnovniPodaciClick;


  // ====================================================
  // NASLOV
  // ====================================================

  Caption :=
    'Sistem Nabavke - ' +
    FImeKorisnika +
    ' (' +
    FUloga +
    ')';


  Show;

end;


