procedure TfrmGlavna.btnNoviZahtevClick(
  Sender: TObject
);
begin

  SakrijSveFrameove;


  if not Assigned(FFraNoviZahtev) then
  begin

    FFraNoviZahtev :=
      TfraNoviZahtev.Create(Self);

    FFraNoviZahtev.Parent :=
      pnlSadrzaj;

    FFraNoviZahtev.Align :=
      alClient;

  end;


  TfraNoviZahtev(
    FFraNoviZahtev
  ).KorisnikID :=
    FKorisnikID;


  FFraNoviZahtev.Visible :=
    True;

  FFraNoviZahtev.BringToFront;

end;


