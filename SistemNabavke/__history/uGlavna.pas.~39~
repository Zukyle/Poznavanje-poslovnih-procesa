    FFraMaterijali
  ).Osvezi;


  FFraMaterijali.Visible :=
    True;

  FFraMaterijali.BringToFront;

end;

// ============================================================
// OSNOVNI PODACI
// ============================================================

procedure TfrmGlavna.btnOsnovniPodaciClick(
  Sender: TObject
);
begin

  SakrijSveFrameove;


  if not Assigned(FFraOsnovniPodaci) then
  begin

    FFraOsnovniPodaci :=
      TfraOsnovniPodaci.Create(Self);

    FFraOsnovniPodaci.Parent :=
      pnlSadrzaj;

    FFraOsnovniPodaci.Align :=
      alClient;

  end;


  // Uvek učitamo najnovije podatke
  TfraOsnovniPodaci(
    FFraOsnovniPodaci
  ).Osvezi;


  FFraOsnovniPodaci.Visible :=
    True;

  FFraOsnovniPodaci.BringToFront;

end;

end.
