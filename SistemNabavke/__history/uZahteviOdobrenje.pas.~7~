procedure TfraZahteviOdobrenje.Osvezi;
begin

  UcitajStatistiku;
  UcitajZahteve;

end;


// ============================================================
// STATISTIKA
// ============================================================

procedure TfraZahteviOdobrenje.UcitajStatistiku;
var
  Q: TFDQuery;
begin

  Q :=
    TFDQuery.Create(nil);

  try

    try

      Q.Connection :=
        frmLogin.FDConnection1;


      // ======================================================
      // SVE TRI STATISTIKE JEDNIM SQL UPITOM
      // ======================================================

      Q.SQL.Text :=

        'SELECT ' +

        // NA ČEKANJU
        'COUNT(CASE ' +
        'WHEN status = ''pending'' ' +
        'THEN 1 END) AS cekanje, ' +

        // HITNI
        'COUNT(CASE ' +
        'WHEN status = ''pending'' ' +
        'AND priority = ''Visok'' ' +
        'THEN 1 END) AS hitni, ' +

        // ODOBRENI
        'COUNT(CASE ' +
        'WHEN status = ''approved'' ' +
        'THEN 1 END) AS odobreni ' +

        'FROM requests';


      Q.Open;


      lblCekanjeBroj.Caption :=
        Q.FieldByName('cekanje').AsString;

      lblHitniBroj.Caption :=
        Q.FieldByName('hitni').AsString;

      lblOdobreniBroj.Caption :=
        Q.FieldByName('odobreni').AsString;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom učitavanja statistike:' +
          sLineBreak +
          E.Message
        );

      end;

    end;

  finally

    Q.Free;

  end;

end;


// ============================================================
// UČITAVANJE PENDING ZAHTEVA
// ============================================================

procedure TfraZahteviOdobrenje.UcitajZahteve;
begin

  qryZahtevi.Close;


  qryZahtevi.SQL.Text :=

    'SELECT ' +


    // ========================================================
    // INTERNI ID
    // ========================================================

    'r.id, ' +


    // ========================================================
    // ŠIFRA
    // ========================================================

    '''Z-'' || ' +
    'strftime(''%Y'', r.created_at) || ' +
    '''-'' || ' +
    'printf(''%04d'', r.id) AS sifra, ' +


    // ========================================================
    // PODNOSILAC
    // ========================================================

    'CAST(u.name AS VARCHAR(100)) ' +
    'AS podnosilac, ' +


    // ========================================================
    // MATERIJAL
    // ========================================================

    'CAST(m.name AS VARCHAR(100)) ' +
    'AS materijal, ' +


    // ========================================================
    // KOLIČINA + JEDINICA
    // ========================================================

    'CAST(' +
    'printf(''%g'', r.quantity) || ' +
    ''' '' || m.unit ' +
    'AS VARCHAR(50)) ' +
    'AS kolicina, ' +


    // ========================================================
    // PRIORITET
    // ========================================================

    'CAST(r.priority AS VARCHAR(30)) ' +
    'AS prioritet, ' +


    // ========================================================
    // DATUM POTREBE
    // ========================================================

    'strftime(''%d.%m.%Y'', r.needed_by) ' +
    'AS datum_potrebe, ' +


    // ========================================================
    // DATUM KREIRANJA
    // ========================================================

    'strftime(''%d.%m.%Y'', r.created_at) ' +
    'AS datum_kreiranja, ' +


    // ========================================================
    // OBRAZLOŽENJE
    // ========================================================

    'CAST(r.reason AS VARCHAR(1000)) ' +
    'AS reason, ' +


    // ========================================================
    // KOMENTAR MENADŽERA
    // ========================================================

    'CAST(r.manager_comment AS VARCHAR(1000)) ' +
    'AS manager_comment, ' +


    // ========================================================
    // STATUS
    // ========================================================

    'CAST(r.status AS VARCHAR(30)) ' +
    'AS status_raw ' +


    // ========================================================
    // TABELE
    // ========================================================

    'FROM requests r ' +

    'INNER JOIN materials m ' +
    'ON m.id = r.material_id ' +

    'INNER JOIN users u ' +
    'ON u.id = r.user_id ' +


    // ========================================================
    // SAMO PENDING
    // ========================================================

    'WHERE r.status = ''pending'' ' +


    // ========================================================
    // VISOK -> SREDNJI -> NIZAK
    // ========================================================

    'ORDER BY ' +

    'CASE r.priority ' +

    'WHEN ''Visok'' THEN 1 ' +
    'WHEN ''Srednji'' THEN 2 ' +
    'WHEN ''Nizak'' THEN 3 ' +

    'ELSE 4 ' +

    'END, ' +

    'r.created_at DESC, ' +
    'r.id DESC';


  try

    qryZahtevi.Open;

    PodesiKolone;

    PrikaziIzabraniZahtev;


  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja zahteva:' +
        sLineBreak +
        E.Message
      );

      OcistiDetalje;

    end;

  end;

end;


// ============================================================
// PODEŠAVANJE KOLONA
