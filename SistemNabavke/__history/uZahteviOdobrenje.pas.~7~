  begin

    FieldName :=
      'sifra';

    Title.Caption :=
      'ID';

    Width :=
      105;

  end;


  // PODNOSILAC
  with dbgZahtevi.Columns.Add do
  begin

    FieldName :=
      'podnosilac';

    Title.Caption :=
      'Podnosilac';

    Width :=
      140;

  end;


  // MATERIJAL
  with dbgZahtevi.Columns.Add do
  begin

    FieldName :=
      'materijal';

    Title.Caption :=
      'Materijal';

    Width :=
      150;

  end;


  // KOLIČINA
  with dbgZahtevi.Columns.Add do
  begin

    FieldName :=
      'kolicina';

    Title.Caption :=
      'Količina';

    Width :=
      80;

  end;


  // PRIORITET
  with dbgZahtevi.Columns.Add do
  begin

    FieldName :=
      'prioritet';

    Title.Caption :=
      'Prioritet';

    Width :=
      80;

  end;


  // DATUM POTREBE
  with dbgZahtevi.Columns.Add do
  begin

    FieldName :=
      'datum_potrebe';

    Title.Caption :=
      'Potrebno do';

    Width :=
      95;

  end;

end;


// ============================================================
// BOJENJE PRIORITETA U DBGRID-U
// ============================================================

procedure TfraZahteviOdobrenje.dbgZahteviDrawColumnCell(
  Sender: TObject;
  const Rect: TRect;
  DataCol: Integer;
  Column: TColumn;
  State: TGridDrawState
);
var
  Prioritet: string;
  TekstRect: TRect;
begin
  if not Assigned(Column.Field) then
  begin
    dbgZahtevi.DefaultDrawColumnCell(
      Rect,
      DataCol,
      Column,
      State
    );
    Exit;
  end;


  // Sve ostale kolone crtamo normalno
  if not SameText(
    Column.Field.FieldName,
    'prioritet'
  ) then
  begin
    dbgZahtevi.DefaultDrawColumnCell(
      Rect,
      DataCol,
      Column,
      State
    );
    Exit;
  end;


  // ==========================================================
  // PRIORITET
  // ==========================================================

  Prioritet :=
    Column.Field.AsString;


  // NOVO - uvek bela/normalna pozadina
  // nema više plavog highlight-a
  dbgZahtevi.Canvas.Brush.Color :=
    dbgZahtevi.Color;

  dbgZahtevi.Canvas.FillRect(Rect);


  // Boja teksta zavisi od prioriteta
  dbgZahtevi.Canvas.Font.Color :=
    BojaPrioriteta(Prioritet);

  dbgZahtevi.Canvas.Font.Style :=
    [fsBold];


  TekstRect := Rect;

  Inc(
    TekstRect.Left,
    4
  );


  dbgZahtevi.Canvas.TextRect(
    TekstRect,
    TekstRect.Left,
    TekstRect.Top + 2,
    Prioritet
  );


  // Vraćamo normalan font za sledeće ćelije
  dbgZahtevi.Canvas.Font.Color :=
    dbgZahtevi.Font.Color;

  dbgZahtevi.Canvas.Font.Style :=
    [];
end;


// ============================================================
// PROMENA IZABRANOG REDA
// ============================================================

procedure TfraZahteviOdobrenje.qryZahteviAfterScroll(
  DataSet: TDataSet
);
begin

  PrikaziIzabraniZahtev;

end;


// ============================================================
// PRIKAZ DETALJA
// ============================================================

procedure TfraZahteviOdobrenje.PrikaziIzabraniZahtev;
var
  Prioritet: string;
begin

  if (not qryZahtevi.Active) or
     qryZahtevi.IsEmpty then
  begin

    OcistiDetalje;

    Exit;

  end;


  // ==========================================================
  // ID
  // ==========================================================

  lblIDZahteva.Caption :=
    qryZahtevi.FieldByName(
      'sifra'
    ).AsString;


  // ==========================================================
  // MATERIJAL
  // ==========================================================

  lblMaterijalVrednost.Caption :=
    qryZahtevi.FieldByName(
      'materijal'
    ).AsString;


  // ==========================================================
  // KOLIČINA
  // ==========================================================

  lblKolicinaVrednost.Caption :=
    qryZahtevi.FieldByName(
      'kolicina'
    ).AsString;


  // ==========================================================
  // PRIORITET
  // ==========================================================

  Prioritet :=
    qryZahtevi.FieldByName(
      'prioritet'
    ).AsString;


  lblPrioritetVrednost.Caption :=
    Prioritet;


  // NOVO - boja prioriteta
  lblPrioritetVrednost.Font.Color :=
    BojaPrioriteta(
      Prioritet
    );


  // ==========================================================
  // DATUM POTREBE
  // ==========================================================

  lblDatumVrednost.Caption :=
    qryZahtevi.FieldByName(
      'datum_potrebe'
    ).AsString;


  // ==========================================================
  // PODNOSILAC
  // ==========================================================

  lblPodnosilacVrednost.Caption :=
    qryZahtevi.FieldByName(
      'podnosilac'
    ).AsString;


  // ==========================================================
  // OBRAZLOŽENJE
  // ==========================================================

  memRazlog.Lines.Text :=
    qryZahtevi.FieldByName(
      'reason'
    ).AsString;


  // ==========================================================
  // KOMENTAR
  // ==========================================================

  memKomentar.Lines.Text :=
    qryZahtevi.FieldByName(
      'manager_comment'
    ).AsString;


  // ==========================================================
  // DUGMAD
  // ==========================================================

  PostaviAkcionaDugmad(
    True
  );

end;


// ============================================================
// ČIŠĆENJE DETALJA
// ============================================================

procedure TfraZahteviOdobrenje.OcistiDetalje;
begin

  lblIDZahteva.Caption :=
    '-';

  lblMaterijalVrednost.Caption :=
    '-';

  lblKolicinaVrednost.Caption :=
    '-';

  lblPrioritetVrednost.Caption :=
    '-';

  // Vraćamo običnu boju
  lblPrioritetVrednost.Font.Color :=
    clWindowText;

  lblDatumVrednost.Caption :=
    '-';

  lblPodnosilacVrednost.Caption :=
    '-';

  memRazlog.Clear;

  memKomentar.Clear;


  PostaviAkcionaDugmad(
    False
  );

end;


