// ============================================================
// KREIRANJE FRAME-A
// ============================================================

constructor TfraZahteviOdobrenje.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);


  // ==========================================================
  // POVEZIVANJE SA BAZOM
  // ==========================================================

  qryZahtevi.Connection :=
    frmLogin.FDConnection1;

  dsZahtevi.DataSet :=
    qryZahtevi;

  dbgZahtevi.DataSource :=
    dsZahtevi;


  // ==========================================================
  // DBGRID
  // ==========================================================

  dbgZahtevi.ReadOnly := True;

  dbgZahtevi.Options :=
    dbgZahtevi.Options + [dgRowSelect];

  // NOVO - ručno crtanje prioriteta
  dbgZahtevi.OnDrawColumnCell :=
    dbgZahteviDrawColumnCell;


  // ==========================================================
  // DOGAĐAJI
  // ==========================================================

  qryZahtevi.AfterScroll :=
    qryZahteviAfterScroll;


  // ==========================================================
  // MEMO
  // ==========================================================

  memRazlog.ReadOnly := True;


  // ==========================================================
  // NOVO - OKRUGLI PANELI ZA IKONICE
  // ==========================================================

  // Rekli smo da svaki panel treba da bude 60 x 60
  pnlIkonaCekanje.Width := 60;
  pnlIkonaCekanje.Height := 60;

  pnlIkonaHitni.Width := 60;
  pnlIkonaHitni.Height := 60;

  pnlIkonaOdobreni.Width := 60;
  pnlIkonaOdobreni.Height := 60;


  pnlIkonaCekanje.BevelOuter := bvNone;
  pnlIkonaHitni.BevelOuter := bvNone;
  pnlIkonaOdobreni.BevelOuter := bvNone;


  NapraviOkrugliPanel(
    pnlIkonaCekanje
  );

  NapraviOkrugliPanel(
    pnlIkonaHitni
  );

  NapraviOkrugliPanel(
    pnlIkonaOdobreni
  );


  // ==========================================================
  // NOVO - BOJE BROJEVA U STATISTICI
  // ==========================================================

  // Sprečavamo VCL Style da preuzme boju fonta
  lblCekanjeBroj.StyleElements :=
    lblCekanjeBroj.StyleElements - [seFont];

  lblHitniBroj.StyleElements :=
    lblHitniBroj.StyleElements - [seFont];

  lblOdobreniBroj.StyleElements :=
    lblOdobreniBroj.StyleElements - [seFont];


  // Na čekanju - NARANDŽASTA
  lblCekanjeBroj.Font.Color :=
    RGB(245, 158, 11);


  // Hitni - CRVENA
  lblHitniBroj.Font.Color :=
    RGB(220, 38, 38);


  // Odobreni - ZELENA
  lblOdobreniBroj.Font.Color :=
    RGB(22, 163, 74);


  // ==========================================================
  // NOVO - PRIORITET U DESNOM PANELU
  // ==========================================================

  lblPrioritetVrednost.StyleElements :=
    lblPrioritetVrednost.StyleElements - [seFont];

  lblPrioritetVrednost.Font.Style :=
    [fsBold];


  // ==========================================================
  // NOVO - CRVENO I ZELENO AKCIONO DUGME
  // ==========================================================

  KreirajAkcionaDugmad;


  // ==========================================================
  // POČETNO STANJE
  // ==========================================================

  OcistiDetalje;

  Osvezi;
end;


// ============================================================
// OKRUGLI PANEL
// ============================================================

procedure TfraZahteviOdobrenje.NapraviOkrugliPanel(
  APanel: TPanel
);
var
  Rgn: HRGN;
begin
  // NOVO - osiguravamo da panel ima kreiran Windows Handle
  APanel.HandleNeeded;

  APanel.Width := 60;
  APanel.Height := 60;

  APanel.BevelOuter := bvNone;
  APanel.ParentBackground := False;

  Rgn := CreateEllipticRgn(
    0,
    0,
    APanel.Width + 1,
    APanel.Height + 1
  );

  SetWindowRgn(
    APanel.Handle,
    Rgn,
    True
  );

  APanel.Invalidate;
end;


// ============================================================
// BOJA PRIORITETA
// ============================================================

function TfraZahteviOdobrenje.BojaPrioriteta(
  const APrioritet: string
): TColor;
begin

  // VISOK = CRVENO
  if SameText(APrioritet, 'Visok') then
  begin
    Result :=
      RGB(220, 38, 38);
  end

  // SREDNJI = NARANDŽASTO
  else if SameText(APrioritet, 'Srednji') then
  begin
    Result :=
      RGB(245, 158, 11);
  end

  // NIZAK = ZELENO
  else if SameText(APrioritet, 'Nizak') then
  begin
    Result :=
      RGB(22, 163, 74);
  end

  else
  begin
    Result := clWindowText;
  end;

end;


// ============================================================
// KREIRANJE CRVENOG I ZELENOG DUGMETA
// ============================================================

procedure TfraZahteviOdobrenje.KreirajAkcionaDugmad;
begin

  // ==========================================================
  // ODBIJ - CRVENO
  // ==========================================================

  FPnlOdbijAkcija :=
    TPanel.Create(Self);

  FPnlOdbijAkcija.Parent :=
    pnlDetalji;

  FPnlOdbijAkcija.SetBounds(
    btnOdbij.Left,
    btnOdbij.Top,
    btnOdbij.Width,
    btnOdbij.Height
  );

  FPnlOdbijAkcija.Caption :=
    'Odbij';

  FPnlOdbijAkcija.BevelOuter :=
    bvNone;

  FPnlOdbijAkcija.ParentBackground :=
    False;

  FPnlOdbijAkcija.StyleElements :=
    FPnlOdbijAkcija.StyleElements -
    [seClient, seFont, seBorder];

  FPnlOdbijAkcija.Color :=
    RGB(220, 38, 38);

  FPnlOdbijAkcija.Font.Color :=
    clWhite;

  FPnlOdbijAkcija.Font.Style :=
    [fsBold];

  FPnlOdbijAkcija.Cursor :=
    crHandPoint;

  FPnlOdbijAkcija.OnClick :=
    btnOdbijClick;


  // ==========================================================
  // ODOBRI - ZELENO
  // ==========================================================

  FPnlOdobriAkcija :=
    TPanel.Create(Self);

  FPnlOdobriAkcija.Parent :=
    pnlDetalji;

  FPnlOdobriAkcija.SetBounds(
    btnOdobri.Left,
    btnOdobri.Top,
    btnOdobri.Width,
    btnOdobri.Height
  );

  FPnlOdobriAkcija.Caption :=
    'Odobri';

  FPnlOdobriAkcija.BevelOuter :=
    bvNone;

  FPnlOdobriAkcija.ParentBackground :=
    False;

  FPnlOdobriAkcija.StyleElements :=
    FPnlOdobriAkcija.StyleElements -
    [seClient, seFont, seBorder];

  FPnlOdobriAkcija.Color :=
    RGB(22, 163, 74);

  FPnlOdobriAkcija.Font.Color :=
    clWhite;

  FPnlOdobriAkcija.Font.Style :=
    [fsBold];

  FPnlOdobriAkcija.Cursor :=
    crHandPoint;

  FPnlOdobriAkcija.OnClick :=
    btnOdobriClick;


  // ==========================================================
  // ORIGINALNA TButton DUGMAD NAM VIŠE NE TREBAJU VIZUELNO
  // ==========================================================

  btnOdbij.Visible :=
    False;

  btnOdobri.Visible :=
    False;


  // Novi paneli moraju biti iznad ostalih kontrola
  FPnlOdbijAkcija.BringToFront;
  FPnlOdobriAkcija.BringToFront;

end;


// ============================================================
// ENABLE / DISABLE AKCIONIH DUGMADI
// ============================================================

procedure TfraZahteviOdobrenje.PostaviAkcionaDugmad(
  AEnabled: Boolean
);
begin

  if Assigned(FPnlOdbijAkcija) then
  begin

    FPnlOdbijAkcija.Enabled :=
      AEnabled;

    if AEnabled then
    begin

      FPnlOdbijAkcija.Color :=
        RGB(220, 38, 38);

      FPnlOdbijAkcija.Cursor :=
        crHandPoint;

    end
    else
    begin

      FPnlOdbijAkcija.Color :=
        RGB(170, 170, 170);

      FPnlOdbijAkcija.Cursor :=
        crDefault;

    end;

  end;


  if Assigned(FPnlOdobriAkcija) then
  begin

    FPnlOdobriAkcija.Enabled :=
      AEnabled;

    if AEnabled then
    begin

      FPnlOdobriAkcija.Color :=
        RGB(22, 163, 74);

      FPnlOdobriAkcija.Cursor :=
        crHandPoint;

    end
    else
    begin

      FPnlOdobriAkcija.Color :=
        RGB(170, 170, 170);

      FPnlOdobriAkcija.Cursor :=
        crDefault;

    end;

  end;

end;


// ============================================================
// OSVEŽAVANJE CELE STRANICE
