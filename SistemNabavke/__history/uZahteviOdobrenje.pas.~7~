procedure TfraZahteviOdobrenje.btnOdobriClick(
  Sender: TObject
);
begin

  OdluciZahtev(
    'approved'
  );

end;


// ============================================================
// ODBIJ
// ============================================================

procedure TfraZahteviOdobrenje.btnOdbijClick(
  Sender: TObject
);
begin

  // Kod odbijanja komentar mora da postoji
  if Trim(
    memKomentar.Text
  ) = '' then
  begin

    ShowMessage(
      'Unesite razlog odbijanja zahteva.'
    );

    memKomentar.SetFocus;

    Exit;

  end;


  OdluciZahtev(
    'rejected'
  );

end;


// ============================================================
// ODLUKA MENADŽERA
// ============================================================

procedure TfraZahteviOdobrenje.OdluciZahtev(
  const NoviStatus: string
);
var
  Q: TFDQuery;

  ZahtevID: Integer;
  SifraZahteva: string;

  Poruka: string;
begin

  // ==========================================================
  // PROVERA
  // ==========================================================

  if (not qryZahtevi.Active) or
     qryZahtevi.IsEmpty then
  begin

    ShowMessage(
      'Nije izabran zahtev.'
    );

    Exit;

  end;


  ZahtevID :=
    qryZahtevi.FieldByName(
      'id'
    ).AsInteger;


  SifraZahteva :=
    qryZahtevi.FieldByName(
      'sifra'
    ).AsString;


  // ==========================================================
  // PORUKA
  // ==========================================================

  if SameText(
    NoviStatus,
    'approved'
  ) then
  begin

    Poruka :=
      'Da li ste sigurni da želite da odobrite zahtev ' +
      SifraZahteva +
      '?';

  end
  else
  begin

    Poruka :=
      'Da li ste sigurni da želite da odbijete zahtev ' +
      SifraZahteva +
      '?';

  end;


  if MessageDlg(
    Poruka,
    mtConfirmation,
    [mbYes, mbNo],
    0
  ) <> mrYes then
    Exit;


  // ==========================================================
  // UPDATE
  // ==========================================================

  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'UPDATE requests ' +

      'SET status = :status, ' +

      'manager_comment = :manager_comment ' +

      'WHERE id = :id ' +

      'AND status = ''pending''';


    Q.ParamByName(
      'status'
    ).AsString :=
      NoviStatus;


    Q.ParamByName(
      'manager_comment'
    ).AsString :=
      Trim(
        memKomentar.Text
      );


    Q.ParamByName(
      'id'
    ).AsInteger :=
      ZahtevID;


    try

      Q.ExecSQL;


      // ======================================================
      // NIJE AŽURIRAN NIJEDAN RED
      // ======================================================

      if Q.RowsAffected = 0 then
      begin

        ShowMessage(
          'Zahtev više ne čeka odobrenje.' +
          sLineBreak +
          'Lista će biti osvežena.'
        );

        Osvezi;

        Exit;

      end;


      // ======================================================
      // USPEH
      // ======================================================

      if SameText(
        NoviStatus,
        'approved'
      ) then
      begin

        ShowMessage(
          'Zahtev ' +
          SifraZahteva +
          ' je uspešno odobren.'
        );

      end
      else
      begin

        ShowMessage(
          'Zahtev ' +
          SifraZahteva +
          ' je odbijen.'
        );

      end;


      // ======================================================
      // OSVEŽAVANJE STATISTIKE + TABELE
      // ======================================================

      Osvezi;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom obrade zahteva:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;

end.
