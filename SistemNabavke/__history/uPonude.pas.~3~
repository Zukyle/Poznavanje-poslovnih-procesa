  begin

    FieldName :=
      'dobavljac';

    Title.Caption :=
      'Dobavljač';

    Width :=
      160;

  end;


  // ==========================================================
  // CENA
  // ==========================================================

  with dbgPonude.Columns.Add do
  begin

    FieldName :=
      'cena_prikaz';

    Title.Caption :=
      'Cena/jed.';

    Width :=
      85;

  end;


  // ==========================================================
  // ROK
  // ==========================================================

  with dbgPonude.Columns.Add do
  begin

    FieldName :=
      'delivery_days';

    Title.Caption :=
      'Rok (dana)';

    Width :=
      80;

  end;


  // ==========================================================
  // USLOVI
  // ==========================================================

  with dbgPonude.Columns.Add do
  begin

    FieldName :=
      'uslovi';

    Title.Caption :=
      'Uslovi isporuke';

    Width :=
      170;

  end;


  // ==========================================================
  // IZABRANA
  // ==========================================================

  with dbgPonude.Columns.Add do
  begin

    FieldName :=
      'izabrana';

    Title.Caption :=
      'Izabrana';

    Width :=
      70;

  end;

end;


// ============================================================
// BROJ PONUDA
// ============================================================

function TfraPonude.BrojPonuda: Integer;
var
  Q: TFDQuery;
begin

  Result := 0;


  if FZahtevID = 0 then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT COUNT(*) AS broj ' +

      'FROM offers ' +

      'WHERE request_id = :request_id';


    Q.ParamByName(
      'request_id'
    ).AsInteger :=
      FZahtevID;


    Q.Open;


    Result :=
      Q.FieldByName(
        'broj'
      ).AsInteger;


  finally

    Q.Free;

  end;

end;


// ============================================================
// PROVERA DUPLIKATA
// ============================================================

function TfraPonude.PonudaVecPostoji(
  AZahtevID: Integer;
  ADobavljacID: Integer
): Boolean;
var
  Q: TFDQuery;
begin

  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT COUNT(*) AS broj ' +

      'FROM offers ' +

      'WHERE request_id = :request_id ' +
      'AND supplier_id = :supplier_id';


    Q.ParamByName(
      'request_id'
    ).AsInteger :=
      AZahtevID;


    Q.ParamByName(
      'supplier_id'
    ).AsInteger :=
      ADobavljacID;


    Q.Open;


    Result :=
      Q.FieldByName(
        'broj'
      ).AsInteger > 0;


  finally

    Q.Free;

  end;

end;


// ============================================================
// ČITANJE CENE
// ============================================================

function TfraPonude.ProcitajCenu(
  out ACena: Double
): Boolean;
var
  S: string;
  FS: TFormatSettings;
begin

  Result :=
    False;


  S :=
    Trim(
      edtCena.Text
    );


  if S = '' then
  begin

    ShowMessage(
      'Unesite cenu po jedinici.'
    );

    edtCena.SetFocus;

    Exit;

  end;


  FS :=
    TFormatSettings.Create;


  // Dozvoljavamo i:
  // 145,50
  // 145.50

  if FS.DecimalSeparator = ',' then
    S := StringReplace(
      S,
      '.',
      ',',
      [rfReplaceAll]
    )
  else
    S := StringReplace(
      S,
      ',',
      '.',
      [rfReplaceAll]
    );


  if not TryStrToFloat(
    S,
    ACena,
    FS
  ) then
  begin

    ShowMessage(
      'Cena nije pravilno uneta.'
    );

    edtCena.SetFocus;

    Exit;

  end;


  if ACena <= 0 then
  begin

    ShowMessage(
      'Cena mora biti veća od 0.'
    );

    edtCena.SetFocus;

    Exit;

  end;


  Result :=
    True;

end;


// ============================================================
// ČITANJE ROKA
// ============================================================

function TfraPonude.ProcitajRok(
  out ARok: Integer
): Boolean;
begin

  Result :=
    False;


  if not TryStrToInt(
    Trim(edtRok.Text),
    ARok
  ) then
  begin

    ShowMessage(
      'Rok isporuke mora biti ceo broj dana.'
    );

    edtRok.SetFocus;

    Exit;

  end;


  if ARok < 0 then
  begin

    ShowMessage(
      'Rok isporuke ne može biti negativan.'
    );

    edtRok.SetFocus;

    Exit;

  end;


  Result :=
    True;

end;


// ============================================================
// DODAJ PONUDU
// ============================================================

procedure TfraPonude.btnDodajPonuduClick(
  Sender: TObject
);
var
  Q: TFDQuery;

  DobavljacID: Integer;

  Cena: Double;
  Rok: Integer;
begin

  // ==========================================================
  // ZAHTEV
  // ==========================================================

  if FZahtevID = 0 then
  begin

    ShowMessage(
      'Prvo izaberite zahtev.'
    );

    Exit;

  end;


  // ==========================================================
  // DOBAVLJAČ
  // ==========================================================

  if cmbDobavljac.ItemIndex < 0 then
  begin

    ShowMessage(
      'Nema dostupnog dobavljača za unos ponude.' +
      sLineBreak +
      'Proverite da li je dobavljač povezan sa ovim materijalom.'
    );

    Exit;

  end;


  DobavljacID :=
    Integer(
      NativeInt(
        cmbDobavljac.Items.Objects[
          cmbDobavljac.ItemIndex
        ]
      )
    );


  // ==========================================================
  // DUPLIKAT
  // ==========================================================

  if PonudaVecPostoji(
    FZahtevID,
    DobavljacID
  ) then
  begin

    ShowMessage(
      'Ovaj dobavljač već ima ponudu za izabrani zahtev.'
    );

    Exit;

  end;


  // ==========================================================
  // CENA
  // ==========================================================

  if not ProcitajCenu(
    Cena
  ) then
    Exit;


  // ==========================================================
  // ROK
  // ==========================================================

  if not ProcitajRok(
    Rok
  ) then
    Exit;


  // ==========================================================
  // INSERT
  // ==========================================================

  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'INSERT INTO offers ' +

      '(' +
        'request_id, ' +
        'supplier_id, ' +
        'unit_price, ' +
        'delivery_days, ' +
        'delivery_terms, ' +
        'note, ' +
        'selected' +
      ') ' +

      'VALUES ' +

      '(' +
        ':request_id, ' +
        ':supplier_id, ' +
        ':unit_price, ' +
        ':delivery_days, ' +
        ':delivery_terms, ' +
        ':note, ' +
        '0' +
      ')';


    Q.ParamByName(
      'request_id'
    ).AsInteger :=
      FZahtevID;


    Q.ParamByName(
      'supplier_id'
    ).AsInteger :=
      DobavljacID;


    Q.ParamByName(
      'unit_price'
    ).AsFloat :=
      Cena;


    Q.ParamByName(
      'delivery_days'
    ).AsInteger :=
      Rok;


    Q.ParamByName(
      'delivery_terms'
    ).AsString :=
      Trim(
        edtUslovi.Text
      );


    Q.ParamByName(
      'note'
    ).AsString :=
      Trim(
        memNapomena.Text
      );


    try

      Q.ExecSQL;


      ShowMessage(
        'Ponuda je uspešno dodata.'
      );


      // ======================================================
      // OSVEŽAVANJE
      // ======================================================

      UcitajPonude;

      // Dobavljač koji je upravo korišćen
      // više se neće nuditi u ComboBox-u.
      UcitajDobavljace;

      OcistiUnosPonude;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom dodavanja ponude:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// OBRIŠI PONUDU
// ============================================================

procedure TfraPonude.btnObrisiPonuduClick(
  Sender: TObject
);
var
  Q: TFDQuery;

  PonudaID: Integer;
  Dobavljac: string;
begin

  if (not FQryPonude.Active) or
     FQryPonude.IsEmpty then
  begin

    ShowMessage(
      'Izaberite ponudu koju želite da obrišete.'
    );

    Exit;

  end;


  // ==========================================================
  // IZABRANA PONUDA
  // ==========================================================

  if FQryPonude.FieldByName(
    'selected'
  ).AsInteger = 1 then
  begin

    ShowMessage(
      'Izabranu ponudu nije moguće obrisati.' +
      sLineBreak +
      'Prvo izaberite drugu ponudu.'
    );

    Exit;

  end;


  PonudaID :=
    FQryPonude.FieldByName(
      'id'
    ).AsInteger;


  Dobavljac :=
    FQryPonude.FieldByName(
      'dobavljac'
    ).AsString;


  if MessageDlg(

    'Da li ste sigurni da želite da obrišete ponudu dobavljača "' +
    Dobavljac +
    '"?',

    mtConfirmation,
    [mbYes, mbNo],
    0

  ) <> mrYes then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    // ========================================================
    // DODATNA ZAŠTITA
    // Ponuda koja se već koristi u narudžbenici ne sme da se briše.
    // ========================================================

    Q.SQL.Text :=

      'SELECT COUNT(*) AS broj ' +

      'FROM orders ' +

      'WHERE offer_id = :offer_id';


    Q.ParamByName(
      'offer_id'
    ).AsInteger :=
      PonudaID;


    Q.Open;


    if Q.FieldByName(
      'broj'
    ).AsInteger > 0 then
    begin

      ShowMessage(
        'Ponudu nije moguće obrisati jer se koristi u narudžbenici.'
      );

      Exit;

    end;


    // ========================================================
    // DELETE
    // ========================================================

    Q.Close;


    Q.SQL.Text :=

      'DELETE FROM offers ' +

      'WHERE id = :id';


    Q.ParamByName(
      'id'
    ).AsInteger :=
      PonudaID;


    try

      Q.ExecSQL;


      ShowMessage(
        'Ponuda je obrisana.'
      );


      UcitajPonude;

      UcitajDobavljace;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom brisanja ponude:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// IZABERI PONUDU
// ============================================================

procedure TfraPonude.btnIzaberiPonuduClick(
  Sender: TObject
);
var
  Q: TFDQuery;

  PonudaID: Integer;
  Dobavljac: string;
begin

  // ==========================================================
  // MINIMUM 3 PONUDE
  // ==========================================================

  if BrojPonuda < 3 then
  begin

    ShowMessage(
      'Za izbor ponude potrebno je najmanje 3 ponude ' +
      'različitih dobavljača.'
    );

    Exit;

  end;


  if (not FQryPonude.Active) or
     FQryPonude.IsEmpty then
  begin

    ShowMessage(
      'Izaberite ponudu.'
    );

    Exit;

  end;


  PonudaID :=
    FQryPonude.FieldByName(
      'id'
    ).AsInteger;


  Dobavljac :=
    FQryPonude.FieldByName(
      'dobavljac'
    ).AsString;


  if MessageDlg(

    'Da li želite da izaberete ponudu dobavljača "' +
    Dobavljac +
    '"?',

    mtConfirmation,
    [mbYes, mbNo],
    0

  ) <> mrYes then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    try

      frmLogin.FDConnection1.StartTransaction;


      // ======================================================
      // PRVO SVE PONUDE ZA ZAHTEV POSTAVLJAMO NA 0
      // ======================================================

      Q.SQL.Text :=

        'UPDATE offers ' +

        'SET selected = 0 ' +

        'WHERE request_id = :request_id';


      Q.ParamByName(
        'request_id'
      ).AsInteger :=
        FZahtevID;


      Q.ExecSQL;


      // ======================================================
      // IZABRANA PONUDA = 1
      // ======================================================

      Q.Close;


      Q.SQL.Text :=

        'UPDATE offers ' +

        'SET selected = 1 ' +

        'WHERE id = :id ' +
        'AND request_id = :request_id';


      Q.ParamByName(
        'id'
      ).AsInteger :=
        PonudaID;


      Q.ParamByName(
        'request_id'
      ).AsInteger :=
        FZahtevID;


      Q.ExecSQL;


      frmLogin.FDConnection1.Commit;


      ShowMessage(
        'Ponuda dobavljača "' +
        Dobavljac +
        '" je izabrana.'
      );


      UcitajPonude;


    except

      on E: Exception do
      begin

        if frmLogin.FDConnection1.InTransaction then
          frmLogin.FDConnection1.Rollback;


        ShowMessage(
          'Greška prilikom izbora ponude:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;

end;


// ============================================================
// PROMENA REDA U TABELI
// ============================================================

procedure TfraPonude.qryPonudeAfterScroll(
  DataSet: TDataSet
);
begin

  btnObrisiPonudu.Enabled :=
    FQryPonude.Active and
    (not FQryPonude.IsEmpty);


  btnIzaberiPonudu.Enabled :=
    FQryPonude.Active and
    (not FQryPonude.IsEmpty) and
    (FQryPonude.RecordCount >= 3);

end;


// ============================================================
// ČIŠĆENJE UNOSA PONUDE
// ============================================================

procedure TfraPonude.OcistiUnosPonude;
begin

  edtCena.Clear;

  edtRok.Clear;

  edtUslovi.Clear;

  memNapomena.Clear;


  if cmbDobavljac.Items.Count > 0 then
    cmbDobavljac.ItemIndex := 0
  else
    cmbDobavljac.ItemIndex := -1;

end;


// ============================================================
// ČIŠĆENJE ZAHTEVA
// ============================================================

procedure TfraPonude.OcistiZahtev;
begin

  FZahtevID :=
    0;

  FMaterijalID :=
    0;


  lblMaterijalVrednost.Caption :=
    '-';

  lblKolicinaVrednost.Caption :=
    '-';

  lblPrioritetVrednost.Caption :=
    '-';

  lblPrioritetVrednost.Font.Color :=
    clWindowText;

  lblDatumVrednost.Caption :=
    '-';


  cmbDobavljac.Items.Clear;


  FQryPonude.Close;


  lblBrojPonuda.Caption :=
    'Broj ponuda: 0 / 3';


  btnIzaberiPonudu.Enabled :=
    False;

  btnObrisiPonudu.Enabled :=
    False;

  btnDodajPonudu.Enabled :=
    False;

end;


// ============================================================
// OTVORI PONUDE ZA KONKRETAN ZAHTEV
// ============================================================

procedure TfraPonude.OtvoriZaZahtev(
  AZahtevID: Integer
);
var
  I: Integer;
begin

  // Prvo učitavamo sve aktuelne odobrene zahteve
  UcitajZahteve;


  for I := 0 to cmbZahtev.Items.Count - 1 do
  begin

    if Integer(
      NativeInt(
        cmbZahtev.Items.Objects[I]
      )
    ) = AZahtevID then
    begin

      cmbZahtev.ItemIndex :=
        I;


      cmbZahtevChange(
        cmbZahtev
      );


      Exit;

    end;

  end;


  ShowMessage(
    'Izabrani zahtev više nije dostupan za unos ponuda.'
  );

end;


