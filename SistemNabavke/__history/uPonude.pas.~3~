    btnIzaberiPonudu: TButton;

  private

    FQryPonude: TFDQuery;
    FDsPonude: TDataSource;

    FZahtevID: Integer;
    FMaterijalID: Integer;

    // ========================================================
    // ZAHTEVI
    // ========================================================

    procedure UcitajZahteve;
    procedure cmbZahtevChange(Sender: TObject);
    procedure UcitajDetaljeZahteva;

    // ========================================================
    // DOBAVLJAČI
    // ========================================================

    procedure UcitajDobavljace;

    // ========================================================
    // PONUDE
    // ========================================================

    procedure UcitajPonude;
    procedure PodesiKolone;

    procedure OcistiUnosPonude;
    procedure OcistiZahtev;

    procedure btnDodajPonuduClick(Sender: TObject);
    procedure btnObrisiPonuduClick(Sender: TObject);
    procedure btnIzaberiPonuduClick(Sender: TObject);

    procedure qryPonudeAfterScroll(DataSet: TDataSet);

    // ========================================================
    // VALIDACIJA
    // ========================================================

    function ProcitajCenu(
      out ACena: Double
    ): Boolean;

    function ProcitajRok(
      out ARok: Integer
    ): Boolean;

    function BrojPonuda: Integer;

    function PonudaVecPostoji(
      AZahtevID: Integer;
      ADobavljacID: Integer
    ): Boolean;

    // ========================================================
    // IZGLED
    // ========================================================

    function BojaPrioriteta(
      const APrioritet: string
    ): TColor;

  public

    constructor Create(
      AOwner: TComponent
    ); override;

    procedure Osvezi;

    // Koristićemo kada kliknemo "Unesi ponude"
    // sa stranice Odobreni zahtevi
    procedure OtvoriZaZahtev(
      AZahtevID: Integer
    );

  end;

implementation

uses
  uLogin;

{$R *.dfm}


// ============================================================
// KREIRANJE FRAME-A
// ============================================================

constructor TfraPonude.Create(
  AOwner: TComponent
);
begin
  inherited Create(AOwner);


  // ==========================================================
  // QUERY ZA PONUDE
  // ==========================================================

  FQryPonude :=
    TFDQuery.Create(Self);

  FQryPonude.Connection :=
    frmLogin.FDConnection1;


  // ==========================================================
  // DATASOURCE
  // ==========================================================

  FDsPonude :=
    TDataSource.Create(Self);

  FDsPonude.DataSet :=
    FQryPonude;


  // ==========================================================
  // GRID
  // ==========================================================

  dbgPonude.DataSource :=
    FDsPonude;

  dbgPonude.ReadOnly :=
    True;

  dbgPonude.Options :=
    dbgPonude.Options + [dgRowSelect];


  FQryPonude.AfterScroll :=
    qryPonudeAfterScroll;


  // ==========================================================
  // COMBOBOX
  // ==========================================================

  cmbZahtev.Style :=
    csDropDownList;

  cmbDobavljac.Style :=
    csDropDownList;


  cmbZahtev.OnChange :=
    cmbZahtevChange;


  // ==========================================================
  // DUGMAD
  // ==========================================================

  btnDodajPonudu.OnClick :=
    btnDodajPonuduClick;

  btnObrisiPonudu.OnClick :=
    btnObrisiPonuduClick;

  btnIzaberiPonudu.OnClick :=
    btnIzaberiPonuduClick;


  // ==========================================================
  // BOJA PRIORITETA
  // ==========================================================

  lblPrioritetVrednost.StyleElements :=
    lblPrioritetVrednost.StyleElements - [seFont];

  lblPrioritetVrednost.Font.Style :=
    [fsBold];


  // ==========================================================
  // POČETNO STANJE
  // ==========================================================

  FZahtevID := 0;
  FMaterijalID := 0;

  OcistiZahtev;
  OcistiUnosPonude;

  Osvezi;
end;


// ============================================================
// OSVEŽAVANJE
// ============================================================

procedure TfraPonude.Osvezi;
begin
  UcitajZahteve;
end;


// ============================================================
// BOJA PRIORITETA
// ============================================================

function TfraPonude.BojaPrioriteta(
  const APrioritet: string
): TColor;
begin

  if SameText(APrioritet, 'Visok') then
    Result := RGB(220, 38, 38)

  else if SameText(APrioritet, 'Srednji') then
    Result := RGB(245, 158, 11)

  else if SameText(APrioritet, 'Nizak') then
    Result := RGB(22, 163, 74)

  else
    Result := clWindowText;

end;


// ============================================================
// UČITAVANJE ODOBRENIH ZAHTEVA U COMBOBOX
// ============================================================

procedure TfraPonude.UcitajZahteve;
var
  Q: TFDQuery;
  PrethodniZahtevID: Integer;
  I: Integer;
begin

  PrethodniZahtevID :=
    FZahtevID;


  cmbZahtev.Items.Clear;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT ' +

      'r.id, ' +

      '''Z-'' || ' +
      'strftime(''%Y'', r.created_at) || ' +
      '''-'' || ' +
      'printf(''%04d'', r.id) AS sifra, ' +

      'CAST(m.name AS VARCHAR(150)) ' +
      'AS materijal ' +

      'FROM requests r ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'WHERE r.status = ''approved'' ' +

      'ORDER BY r.needed_by ASC, r.id DESC';


    try

      Q.Open;


      while not Q.Eof do
      begin

        cmbZahtev.Items.AddObject(

          Q.FieldByName('sifra').AsString +
          ' - ' +
          Q.FieldByName('materijal').AsString,

          TObject(
            NativeInt(
              Q.FieldByName('id').AsInteger
            )
          )

        );


        Q.Next;
      end;


    except

      on E: Exception do
      begin

        ShowMessage(
          'Greška prilikom učitavanja zahteva:' +
          sLineBreak +
          E.Message
        );

      end;

    end;


  finally

    Q.Free;

  end;


  // ==========================================================
  // POKUŠAVAMO DA VRATIMO PRETHODNO IZABRANI ZAHTEV
  // ==========================================================

  cmbZahtev.ItemIndex :=
    -1;


  if PrethodniZahtevID <> 0 then
  begin

    for I := 0 to cmbZahtev.Items.Count - 1 do
    begin

      if Integer(
        NativeInt(
          cmbZahtev.Items.Objects[I]
        )
      ) = PrethodniZahtevID then
      begin

        cmbZahtev.ItemIndex :=
          I;

        Break;

      end;

    end;

  end;


  // Ako prethodni ne postoji, biramo prvi
  if (cmbZahtev.ItemIndex = -1) and
     (cmbZahtev.Items.Count > 0) then
  begin

    cmbZahtev.ItemIndex :=
      0;

  end;


  if cmbZahtev.ItemIndex >= 0 then
    cmbZahtevChange(cmbZahtev)
  else
    OcistiZahtev;

end;


// ============================================================
// PROMENA ZAHTEVA
// ============================================================

procedure TfraPonude.cmbZahtevChange(
  Sender: TObject
);
begin

  if cmbZahtev.ItemIndex < 0 then
  begin

    OcistiZahtev;

    Exit;

  end;


  FZahtevID :=
    Integer(
      NativeInt(
        cmbZahtev.Items.Objects[
          cmbZahtev.ItemIndex
        ]
      )
    );


  UcitajDetaljeZahteva;

  UcitajDobavljace;

  // NOVO
  btnDodajPonudu.Enabled :=
  cmbDobavljac.Items.Count > 0;

  UcitajPonude;

  OcistiUnosPonude;

end;


// ============================================================
// DETALJI ZAHTEVA
// ============================================================

procedure TfraPonude.UcitajDetaljeZahteva;
var
  Q: TFDQuery;
  Prioritet: string;
begin

  if FZahtevID = 0 then
  begin

    OcistiZahtev;

    Exit;

  end;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    Q.SQL.Text :=

      'SELECT ' +

      'r.material_id, ' +

      'CAST(m.name AS VARCHAR(150)) ' +
      'AS materijal, ' +

      'CAST(' +
        'printf(''%g'', r.quantity) || ' +
        ''' '' || m.unit ' +
      'AS VARCHAR(50)) ' +
      'AS kolicina, ' +

      'CAST(r.priority AS VARCHAR(30)) ' +
      'AS prioritet, ' +

      'strftime(''%d.%m.%Y'', r.needed_by) ' +
      'AS datum_potrebe ' +

      'FROM requests r ' +

      'INNER JOIN materials m ' +
      'ON m.id = r.material_id ' +

      'WHERE r.id = :id ' +
      'AND r.status = ''approved''';


    Q.ParamByName('id').AsInteger :=
      FZahtevID;


    Q.Open;


    if Q.IsEmpty then
    begin

      OcistiZahtev;

      Exit;

    end;


    FMaterijalID :=
      Q.FieldByName(
        'material_id'
      ).AsInteger;


    lblMaterijalVrednost.Caption :=
      Q.FieldByName(
        'materijal'
      ).AsString;


    lblKolicinaVrednost.Caption :=
      Q.FieldByName(
        'kolicina'
      ).AsString;


    Prioritet :=
      Q.FieldByName(
        'prioritet'
      ).AsString;


    lblPrioritetVrednost.Caption :=
      Prioritet;

    lblPrioritetVrednost.Font.Color :=
      BojaPrioriteta(
        Prioritet
      );


    lblDatumVrednost.Caption :=
      Q.FieldByName(
        'datum_potrebe'
      ).AsString;


  finally

    Q.Free;

  end;

end;


// ============================================================
// UČITAVANJE ODGOVARAJUĆIH DOBAVLJAČA
// ============================================================

procedure TfraPonude.UcitajDobavljace;
var
  Q: TFDQuery;
begin

  cmbDobavljac.Items.Clear;
  cmbDobavljac.ItemIndex := -1;


  if (FZahtevID = 0) or
     (FMaterijalID = 0) then
    Exit;


  Q :=
    TFDQuery.Create(nil);

  try

    Q.Connection :=
      frmLogin.FDConnection1;


    // ========================================================
    // PRIKAZUJEMO SAMO DOBAVLJAČE KOJI:
    //
    // 1. dobavljaju ovaj materijal
    // 2. još nemaju ponudu za ovaj zahtev
    // ========================================================

    Q.SQL.Text :=

      'SELECT ' +

      's.id, ' +

      'CAST(s.name AS VARCHAR(150)) ' +
      'AS naziv ' +

      'FROM suppliers s ' +

      'INNER JOIN supplier_materials sm ' +
      'ON sm.supplier_id = s.id ' +

      'WHERE sm.material_id = :material_id ' +

      'AND NOT EXISTS (' +

        'SELECT 1 ' +
        'FROM offers o ' +

        'WHERE o.request_id = :request_id ' +
        'AND o.supplier_id = s.id' +

      ') ' +

      'ORDER BY s.name ASC';


    Q.ParamByName(
      'material_id'
    ).AsInteger :=
      FMaterijalID;


    Q.ParamByName(
      'request_id'
    ).AsInteger :=
      FZahtevID;


    Q.Open;


    while not Q.Eof do
    begin

      cmbDobavljac.Items.AddObject(

        Q.FieldByName(
          'naziv'
        ).AsString,

        TObject(
          NativeInt(
            Q.FieldByName(
              'id'
            ).AsInteger
          )
        )

      );


      Q.Next;

    end;


    if cmbDobavljac.Items.Count > 0 then
      cmbDobavljac.ItemIndex := 0;


  finally

    Q.Free;

  end;

end;


// ============================================================
// UČITAVANJE PONUDA
// ============================================================

procedure TfraPonude.UcitajPonude;
var
  Broj: Integer;
begin

  FQryPonude.Close;


  if FZahtevID = 0 then
  begin

    lblBrojPonuda.Caption :=
      'Broj ponuda: 0 / 3';

    btnIzaberiPonudu.Enabled :=
      False;

    btnObrisiPonudu.Enabled :=
      False;

    Exit;

  end;


  FQryPonude.SQL.Text :=

    'SELECT ' +

    'o.id, ' +

    'o.supplier_id, ' +

    'CAST(s.name AS VARCHAR(150)) ' +
    'AS dobavljac, ' +

    'o.unit_price, ' +

    'CAST(' +
      'printf(''%.2f'', o.unit_price) ' +
    'AS VARCHAR(50)) ' +
    'AS cena_prikaz, ' +

    'o.delivery_days, ' +

    'CAST(COALESCE(o.delivery_terms, '''') ' +
    'AS VARCHAR(250)) ' +
    'AS uslovi, ' +

    'CAST(COALESCE(o.note, '''') ' +
    'AS VARCHAR(500)) ' +
    'AS napomena, ' +

    'o.selected, ' +

    'CAST(' +

      'CASE ' +
      'WHEN o.selected = 1 THEN ''Da'' ' +
      'ELSE ''Ne'' ' +
      'END ' +

    'AS VARCHAR(10)) ' +
    'AS izabrana ' +

    'FROM offers o ' +

    'INNER JOIN suppliers s ' +
    'ON s.id = o.supplier_id ' +

    'WHERE o.request_id = :request_id ' +

    'ORDER BY o.selected DESC, ' +
    'o.unit_price ASC, ' +
    'o.delivery_days ASC';


  FQryPonude.ParamByName(
    'request_id'
  ).AsInteger :=
    FZahtevID;


  try

    FQryPonude.Open;

    PodesiKolone;


    Broj :=
      FQryPonude.RecordCount;


    lblBrojPonuda.Caption :=
      'Broj ponuda: ' +
      IntToStr(Broj) +
      ' / 3';


    btnIzaberiPonudu.Enabled :=
      (Broj >= 3) and
      (not FQryPonude.IsEmpty);


    btnObrisiPonudu.Enabled :=
      not FQryPonude.IsEmpty;


  except

    on E: Exception do
    begin

      ShowMessage(
        'Greška prilikom učitavanja ponuda:' +
        sLineBreak +
        E.Message
      );

    end;

  end;

end;


// ============================================================
// KOLONE TABELE
