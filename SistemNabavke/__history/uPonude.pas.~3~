    lblDobavljacNaslov: TLabel;
    cmbDobavljac: TComboBox;

    lblCenaNaslov: TLabel;
    edtCena: TEdit;

    lblRokNaslov: TLabel;
    edtRok: TEdit;

    lblUsloviNaslov: TLabel;
    edtUslovi: TEdit;

    lblNapomenaNaslov: TLabel;
    memNapomena: TMemo;

    btnDodajPonudu: TButton;

    // ========================================================
    // GORE LEVO - ZAHTEV
    // ========================================================

