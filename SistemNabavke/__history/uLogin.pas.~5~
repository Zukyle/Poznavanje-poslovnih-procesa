unit uLogin;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, FireDAC.Stan.Intf,
  FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf, FireDAC.Phys.Intf,
  FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys,
  FireDAC.VCLUI.Wait, FireDAC.Stan.Param, FireDAC.DatS, FireDAC.DApt.Intf,
  FireDAC.DApt, FireDAC.Stan.ExprFuncs, FireDAC.Phys.SQLiteWrapper.Stat,
  FireDAC.Phys.SQLiteDef, FireDAC.Phys.SQLite, Data.DB, FireDAC.Comp.DataSet,
  FireDAC.Comp.Client,
  System.Hash;

type
  TfrmLogin = class(TForm)
    lblKorisnickoIme: TLabel;
    lblLozinka: TLabel;
    edtKorisnickoIme: TEdit;
    edtLozinka: TEdit;
    btnPrijaviSe: TButton;
    FDConnection1: TFDConnection;
    FDQuery1: TFDQuery;
    FDPhysSQLiteDriverLink1: TFDPhysSQLiteDriverLink;
    procedure FormCreate(Sender: TObject);
    procedure btnPrijaviSeClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmLogin: TfrmLogin;

implementation

{$R *.dfm}

procedure TfrmLogin.btnPrijaviSeClick(Sender: TObject);
var
  HashLozinke: string;
  KorisnikID: Integer;
  KorisnickoIme: string;
  ImeKorisnika: string;
  Uloga: string;
begin
  // Provera korisnickog imena
  if Trim(edtKorisnickoIme.Text) = '' then
  begin
    ShowMessage('Unesite korisničko ime.');
    edtKorisnickoIme.SetFocus;
    Exit;
  end;

  // Provera lozinke
  if edtLozinka.Text = '' then
  begin
    ShowMessage('Unesite lozinku.');
    edtLozinka.SetFocus;
    Exit;
  end;

  // Pretvaramo unesenu lozinku u SHA-256
  HashLozinke :=
    THashSHA2.GetHashString(edtLozinka.Text);

  FDQuery1.Close;

  FDQuery1.SQL.Text :=
    'SELECT id, username, name, role ' +
    'FROM users ' +
    'WHERE username = :username ' +
    'AND password_hash = :password_hash ' +
    'AND active = 1';

  FDQuery1.ParamByName('username').AsString :=
    Trim(edtKorisnickoIme.Text);

  FDQuery1.ParamByName('password_hash').AsString :=
    HashLozinke;

  FDQuery1.Open;

  // Ako korisnik nije pronadjen
  if FDQuery1.IsEmpty then
  begin
    ShowMessage('Pogrešno korisničko ime ili lozinka.');

    edtLozinka.Clear;
    edtLozinka.SetFocus;

    Exit;
  end;

  // Citamo podatke korisnika
  KorisnikID :=
    FDQuery1.FieldByName('id').AsInteger;

  KorisnickoIme :=
    FDQuery1.FieldByName('username').AsString;

  ImeKorisnika :=
    FDQuery1.FieldByName('name').AsString;

  Uloga :=
    FDQuery1.FieldByName('role').AsString;

  // PRIVREMENO - proveravamo da login radi
  ShowMessage(
    'Uspešna prijava!' + sLineBreak +
    sLineBreak +
    'ID: ' + IntToStr(KorisnikID) + sLineBreak +
    'Korisničko ime: ' + KorisnickoIme + sLineBreak +
    'Ime: ' + ImeKorisnika + sLineBreak +
    'Uloga: ' + Uloga
  );
end;

procedure TfrmLogin.FormCreate(Sender: TObject);
var
  PutanjaBaze: string;
begin
  // Baza se nalazi pored .exe fajla
  PutanjaBaze :=
    ExtractFilePath(ParamStr(0)) + 'nabavke.db';

  // Provera da li baza postoji
  if not FileExists(PutanjaBaze) then
  begin
    ShowMessage(
      'Baza nije pronađena:' +
      sLineBreak +
      PutanjaBaze
    );

    Exit;
  end;

  // Podešavanje SQLite konekcije
  FDConnection1.Connected := False;
  FDConnection1.Params.Clear;

  FDConnection1.Params.Add('DriverID=SQLite');
  FDConnection1.Params.Add('Database=' + PutanjaBaze);

  FDConnection1.LoginPrompt := False;

  // Otvaranje konekcije
  FDConnection1.Connected := True;

  // Query koristi ovu konekciju
  FDQuery1.Connection := FDConnection1;

  // Privremeno - samo da proverimo da radi
  ShowMessage('Uspešno povezivanje sa bazom!');
end;

end.
